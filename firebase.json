{
  "hosting": {
    "site": "sanitaryflow-erp",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      ".agents",
      ".agents/**",
      ".codex",
      ".codex/**",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "proxy/**",
      "work/**",
      "outputs/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
