rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // RBAC (Phase 1): members/{staffUid} docs live under the owner's own
    // users/{ownerUid} tree -- no data restructuring needed. A get() lookup
    // (not a custom claim) is the source of truth for role/store access so
    // that disabling a staff member takes effect on their very next request,
    // not after their ID token happens to expire.
    function memberDocPath(ownerUid) {
      return /databases/$(database)/documents/users/$(ownerUid)/members/$(request.auth.uid);
    }

    function isActiveMember(ownerUid) {
      return signedIn()
        && exists(memberDocPath(ownerUid))
        && get(memberDocPath(ownerUid)).data.status == "active";
    }

    function memberRole(ownerUid) {
      return isActiveMember(ownerUid) ? get(memberDocPath(ownerUid)).data.role : null;
    }

    function memberStoreIds(ownerUid) {
      return isActiveMember(ownerUid) ? get(memberDocPath(ownerUid)).data.storeIds : [];
    }

    // "all" is an explicit opt-in for a member who should see every branch
    // (e.g. a roaming manager) -- absent that, a member only reaches the
    // specific storeIds assigned to them.
    function memberCanAccessStore(ownerUid, storeId) {
      let ids = memberStoreIds(ownerUid);
      return ("all" in ids) || (storeId in ids);
    }

    function isOwnerOrRole(ownerUid, roles) {
      return isOwner(ownerUid) || memberRole(ownerUid) in roles;
    }

    // Deletion lifecycle, phase 1 (see SECURITY-AUDIT.md F-1 and
    // DATA-DELETION.md). Once an owner requests deletion their tenant is
    // frozen read-only for a 30-day grace period: existing data stays
    // readable so they can review it and self-serve a restore, but nothing
    // new may be written. Only the proxy's Admin SDK can set or clear this
    // status -- no client can, because users/{userId} update forbids
    // changing it (see the users match block).
    //
    // A missing users/{userId} doc is treated as active: a brand-new signup
    // writes its first store before its profile document exists, and an
    // absent profile must not read as "frozen".
    //
    // Applied to WRITES only, deliberately. Every get() inside a rule is a
    // billed read, and reads outnumber writes heavily in a POS. Immediate
    // read lockout for STAFF is handled instead by the proxy disabling their
    // Firebase Auth accounts and revoking refresh tokens at request time,
    // which is both free and faster-acting than any rule.
    function tenantNotFrozen(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId))
        || get(/databases/$(database)/documents/users/$(userId)).data.get('status', 'active') != 'pending_deletion';
    }

    // Upper bounds on every number written here.
    //
    // These existed only as `>= 0`, which let two things through. Infinity
    // satisfies both `is number` and `>= 0`, so a price or a quantity of
    // Infinity was accepted -- and once stored, every total and report that
    // touches the row is Infinity too, with no arithmetic that recovers it.
    // Values above 2^53 were also accepted and silently lose integer
    // precision: 9007199254740993 stores as 9007199254740992, so a stock
    // count is quietly wrong rather than visibly rejected. Both were measured
    // against these rules, not assumed.
    //
    // The ceilings are deliberately far above any real shop. They exist to
    // keep arithmetic exact, not to judge what a business may sell. In TZS a
    // billion is roughly USD 380,000 for a single unit. The sale ceiling is
    // set so 40 lines (the item cap) at the per-line maxima still land well
    // inside the safe-integer range.
    //
    // The client mirrors these in app.js and rejects with a readable message
    // first; tests/validation-limits.test.mjs fails if the two ever disagree.
    function countInRange(v) {
      return v is number && v >= 0 && v <= 1000000;
    }

    // Stock on a shelf, which may legitimately be negative (L-9, phase A).
    //
    // Everything else counted here stays non-negative: a reorder level, a
    // number of units sold, a transfer quantity. A shelf is different. Once
    // offline selling exists a cashier can sell stock the cached count said was
    // there and the server already knew was gone, and the agreed policy is to
    // take the sale and flag it rather than refuse a paying customer.
    //
    // Without this, that sale is rejected at REPLAY time -- silently, hours
    // later, after the customer has left and the money is in the drawer. A
    // guard that discards completed sales without telling anyone is worse than
    // the negative number it was protecting against.
    //
    // Negative stock is a signal, not corruption: it means more was sold than
    // the system believed was there, which is exactly what an owner needs to
    // see. It is still bounded, so a typo or a loop cannot write nonsense.
    function stockCountInRange(v) {
      return v is number && v >= -1000000 && v <= 1000000;
    }
    function moneyInRange(v) {
      return v is number && v >= 0 && v <= 1000000000;
    }
    // Variance is counted minus expected, so it is negative exactly when the
    // drawer is short -- the case the whole feature exists to surface. The
    // unsigned helpers above would reject precisely the shifts worth reading.
    function signedMoneyInRange(v) {
      return v is number && v >= -1000000000 && v <= 1000000000;
    }

    function totalInRange(v) {
      return v is number && v >= 0 && v <= 1000000000000;
    }

    function validProduct() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.category is string && d.category.size() <= 60
        && d.brand is string && d.brand.size() <= 60
        && d.supplier is string && d.supplier.size() <= 60
        && stockCountInRange(d.quantity)
        && d.storeId is string && d.storeId.size() > 0
        && (!('barcode' in d) || (d.barcode is string && d.barcode.size() <= 64))
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && (!('warehouse' in d) || (d.warehouse is string && d.warehouse.size() <= 60))
        && (!('shelf' in d) || (d.shelf is string && d.shelf.size() <= 60))
        && (!('sku' in d) || (d.sku is string && d.sku.size() <= 40))
        && (!('costPrice' in d) || moneyInRange(d.costPrice))
        && (!('sellingPrice' in d) || moneyInRange(d.sellingPrice))
        && (!('reorderLevel' in d) || countInRange(d.reorderLevel))
        && (!('expiryDate' in d) || (d.expiryDate is string && d.expiryDate.size() <= 10))
        // Absent means standard-rated, which is what taxClassOf() defaults to.
        // Defaulting the other way would silently under-collect on every
        // product added before this field existed.
        && (!('taxClass' in d) || d.taxClass in ['standard', 'zeroRated', 'exempt']);
    }

    function productImmutableFieldsUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('storeId' in resource.data) || request.resource.data.storeId == resource.data.storeId);
    }

    // Cashier-safe stock movement: staff may move stock levels but touch
    // nothing else on the product doc -- name/price/category/etc. stay
    // owner-only edits. diff().affectedKeys() proves exactly which fields
    // changed, so this can't be widened into a general product edit.
    //
    // Covers all four client stock paths, which each write exactly this field
    // set: a sale decrements quantity and raises sold30/sold90; a restock
    // raises quantity alone; a return or void does the reverse of a sale.
    //
    // Deliberately NOT increase-only. An earlier version required
    // quantity >= resource.data.quantity, which blocked the sale path
    // outright -- the stock decrement was denied inside the same transaction
    // that created the sale, so the transaction rolled back and no cashier or
    // manager could complete a sale at all.
    //
    // Note the real limit here: rules authorize each write independently, so
    // this cannot verify that a matching sale document was created in the
    // same transaction. A cashier could therefore write down stock without a
    // corresponding sale. The compensating controls are the sale record and
    // the auditLogs entry (both required and both owner-readable), plus
    // physical stock reconciliation -- not this rule.
    // F-4. movementReason records WHY stock moved, so the owner's audit trail
    // distinguishes a sale from a restock from a return instead of showing a
    // bare number change. Only the enum is validated here.
    //
    // Direction-coupling (rejecting a "restock" that decreases stock) was
    // implemented and then deliberately removed. It could not be made both
    // correct and safe: keying off field presence meant a persisted value
    // constrained later writes that omitted the field, so a product left
    // reading "restock" rejected the next sale and took the till offline;
    // keying off diff().affectedKeys() meant consecutive sales -- the normal
    // case, same value each time -- skipped validation altogether. Both were
    // caught by tests/rules-deletion.test.mjs.
    //
    // The security value was negligible either way: someone writing stock down
    // to cover theft simply omits the field or labels it "sale". Prevention is
    // not reachable in rules, because rules authorise each write independently
    // and so cannot tie a stock decrement to a sale document created in the
    // same transaction. The real control is detective -- the sale record plus
    // the auditLogs entry, reconciled by the owner -- which is what this field
    // exists to make precise. See SECURITY-AUDIT.md F-4.
    function validMovementReason() {
      let after = request.resource.data;
      return !('movementReason' in after)
        || after.movementReason in ['sale', 'restock', 'return', 'void'];
    }

    function validStockMovementUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'sold30', 'sold90', 'updatedAt', 'movementReason'])
        && stockCountInRange(request.resource.data.quantity)
        && (!('sold30' in request.resource.data) || countInRange(request.resource.data.sold30))
        && (!('sold90' in request.resource.data) || countInRange(request.resource.data.sold90))
        && validMovementReason();
    }

    // Per-item content validation used to live here as validSaleItem() applied
    // across 40 manually unrolled slots. It had to go: Firestore caps a single
    // rule evaluation at 1000 expressions, and that unroll blew the cap for any
    // STAFF sale of two or more line items. Staff pay for the member-document
    // get()s that decide their role and store access; an owner does not, because
    // isOwner() short-circuits first. So the owner could sell any basket while
    // every cashier hit permission-denied on their second line item -- the exact
    // shape of the outage this replaces, and invisible to owner-side testing.
    //
    // Measured, not guessed (tests/rules-budget-probe*.mjs): 40 slots died at 2
    // items; trimming the per-item checks reached 10; collapsing the duplicate
    // member get()s into memberSellsInStore() below still died at 5. Only
    // dropping per-item iteration makes the cost constant, and a 40-line basket
    // then passes comfortably.
    //
    // What remains is everything that is cheap AND load-bearing: the basket is a
    // list of 1..40, cashierUid is pinned to the caller, storeId must be one the
    // member is assigned to, and the totals/orderNumber/staffName shapes below.
    // What is given up is cosmetic: per-line name and brand lengths, and a
    // per-line qty > 0. Neither was a security boundary. Stock movement is
    // authorised separately and independently (quantity >= 0, field-limited),
    // so an item row cannot move stock on its own, and the file already
    // documents that rules cannot tie a decrement to the sale that caused it --
    // the sale record plus auditLogs, reconciled by the owner, is that control.
    function validSaleItems(items) {
      return items is list && items.size() > 0 && items.size() <= 40;
    }

    // One member read for role AND store, instead of isOwnerOrRole() and
    // memberCanAccessStore() each doing their own. Same decision, measurably
    // cheaper on the hottest write in the schema.
    function memberSellsInStore(ownerUid, storeId) {
      let path = memberDocPath(ownerUid);
      let m = exists(path) ? get(path).data : null;
      return m != null
        && m.status == "active"
        && m.role in ["manager", "cashier"]
        && (("all" in m.storeIds) || (storeId in m.storeIds));
    }

    function validSale() {
      let d = request.resource.data;
      return validSaleItems(d.items)
        && totalInRange(d.total)
        && d.cashierUid == request.auth.uid
        && d.voided == false
        && d.storeId is string && d.storeId.size() > 0
        && d.staffId is string && d.staffId.size() > 0
        && d.staffName is string && d.staffName.size() > 0 && d.staffName.size() <= 80
        && d.orderNumber is string && d.orderNumber.matches('^[0-9]{1,10}$')
        && (!('subtotal' in d) || totalInRange(d.subtotal))
        // QA-113. Both were range-checked and neither was tied to the other, so
        // a sale could claim a 1,000,000 subtotal and a total of 100. Past this
        // point the discount is client-side only, which is precisely what the
        // override password exists to control.
        && (!('subtotal' in d) || d.total == d.subtotal - d.get('discountAmount', 0))
        && (!('discountType' in d) || d.discountType in ['none', 'percent', 'fixed'])
        && (!('discountValue' in d) || totalInRange(d.discountValue))
        && (!('discountAmount' in d) || totalInRange(d.discountAmount))
        && d.paymentMethod in ['cash', 'mobile', 'card', 'credit']
        && (!('customerId' in d) || d.customerId == null || (d.customerId is string && d.customerId.size() > 0))
        && (!('amountPaid' in d) || d.amountPaid == null || totalInRange(d.amountPaid))
        && (!('balanceDue' in d) || d.balanceDue == null || totalInRange(d.balanceDue))
        // Filed in DESIGN §13 and deferred only because no emulator was
        // available to re-run the rules suites at the time. A sale rung up with
        // no connection is marked so a shelf count can be trusted or not, and
        // the field was type-free: madeOffline: "no" would have been accepted,
        // and any truthiness check downstream would then read a perfectly
        // ordinary sale as rung up blind. Every reader tests === true, which
        // closes it in practice; this closes it at the boundary.
        && (!('madeOffline' in d) || d.madeOffline is bool)
        // VAT (DESIGN-vat.md). All optional: a business that is not registered
        // writes none of them, and a sale from before it registered is outside
        // the scheme rather than taxed at zero.
        //
        // The last clause is the one worth the expressions. Rules cannot sum a
        // list, so they cannot check the tax against the items -- but net and
        // tax are scalars, and their sum is exactly the property the whole
        // feature is judged on. Enforcing it here means a client bug cannot
        // write a sale whose VAT return fails to reconcile to its own takings.
        && (!('vatRegistered' in d) || d.vatRegistered is bool)
        && (!('vrn' in d) || (d.vrn is string && d.vrn.size() <= 20))
        && (!('vatRate' in d) || (d.vatRate is number && d.vatRate >= 0 && d.vatRate <= 1))
        && (!('taxTotal' in d) || totalInRange(d.taxTotal))
        && (!('netTotal' in d) || totalInRange(d.netTotal))
        && (!('taxBreakdown' in d) || d.taxBreakdown is map)
        // QA-112. Written as `!a || !b || reconciles`, the guard short-circuits
        // to true whenever either side is missing -- so a sale carrying taxTotal
        // alone validated with any tax figure at all, on the one clause the
        // whole feature is judged on. They travel together or not at all.
        && (('taxTotal' in d) == ('netTotal' in d))
        && (!('taxTotal' in d) || d.netTotal + d.taxTotal == d.total);
    }

    function validShiftOpen() {
      let d = request.resource.data;
      return d.storeId is string && d.storeId.size() > 0
        && d.status == "open"
        && moneyInRange(d.openingFloat)
        && d.openedByUid == request.auth.uid
        && d.openedByName is string && d.openedByName.size() > 0 && d.openedByName.size() <= 80
        && (!('storeName' in d) || (d.storeName is string && d.storeName.size() <= 60));
    }

    // A close may only ever move an open shift to closed, and may not rewrite
    // how it opened. Without pinning the opening fields, a short drawer could be
    // reconciled away after the fact by raising the float it claims to have
    // started with.
    //
    // Pinning the float alone was not enough. The drawer is judged by
    //
    //     variance     = countedCash - expectedCash
    //     expectedCash = openingFloat + cashSales - cashRefunds + cashRepayments
    //
    // and closeShift() computes every one of those on the client. While the
    // rule only range-checked them, the person holding the cash supplied BOTH
    // sides of the subtraction meant to catch them: take 50,000, count the
    // drawer honestly, write expectedCash down to match, and the shift closes
    // balanced. Same attack the float pinning was written to stop, one field
    // along.
    //
    // What follows cannot prove cashSales -- rules cannot aggregate a shift's
    // sales, and no arrangement of them will. What it can do is force the five
    // numbers to agree with each other, which moves any lie out of `variance`,
    // where nothing contradicts it, and into `cashSales`, where the owner can
    // reconcile it against the sales collection. An unfalsifiable number
    // becomes a falsifiable one. The remaining gap is detective, not
    // preventive, and is recorded as such in KNOWN-LIMITATIONS.md.
    //
    // The arithmetic is written in the same order as app.js evaluates it, so
    // IEEE-754 rounding lands identically on both sides of the comparison.
    function shiftExpectedCashIsDerived() {
      let d = request.resource.data;
      return moneyInRange(d.cashSales)
        && moneyInRange(d.cashRefunds)
        && moneyInRange(d.cashRepayments)
        && d.expectedCash == resource.data.openingFloat + d.cashSales - d.cashRefunds + d.cashRepayments;
    }

    function validShiftClose() {
      let d = request.resource.data;
      return resource.data.status == "open"
        && d.status == "closed"
        && d.openingFloat == resource.data.openingFloat
        && d.openedByUid == resource.data.openedByUid
        && d.openedAt == resource.data.openedAt
        && d.storeId == resource.data.storeId
        && moneyInRange(d.countedCash)
        && moneyInRange(d.expectedCash)
        && signedMoneyInRange(d.variance)
        && shiftExpectedCashIsDerived()
        && d.variance == d.countedCash - d.expectedCash
        && d.closedByUid == request.auth.uid
        && d.closedByName is string && d.closedByName.size() > 0 && d.closedByName.size() <= 80
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    // Managers and cashiers may set which shift a till is currently on, and
    // nothing else about the store. Widening store writes outright would let a
    // cashier rename a branch or change its currency.
    function validShiftPointerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentShiftId']);
    }

    // The audit log is the detective control that F-4 falls back on when rules
    // cannot bind a stock decrement to a sale, so it is validated at least as
    // tightly as errorLog below it -- previously it was the loosest collection
    // in the schema, accepting any action string and any fields alongside it.
    //
    // Three separate problems, all reachable by an ordinary cashier's client:
    // a forged `action` ("SALE_VOIDED" from someone who cannot void) lays a
    // false trail through the one record the owner trusts; unbounded fields
    // and unbounded document width let the collection be filled with noise
    // until a real entry is unfindable; and every byte of it is billed to the
    // owner. `uid` was always honest -- everything the owner actually reads
    // was not.
    //
    // Actions are scoped to the role that can perform the underlying act. A
    // cashier cannot void a sale, so a cashier recording a void is either a
    // bug or misdirection; neither belongs in the ledger. The member get()
    // this costs is already paid by the create rule below, so scoping is
    // effectively free.
    function cashierAuditActions() {
      return ['SALE_COMPLETED', 'PRODUCT_RESTOCKED', 'PAYMENT_RECORDED', 'CREDIT_LIMIT_EXCEEDED',
              // Credit extended with no ceiling check at all -- the customer was not
              // visible to this account, or had no limit set (QA-110/QA-120).
              // Cashier-writable because a cashier is who makes that sale.
              'CREDIT_LIMIT_UNCHECKED'];
    }
    function managerAuditActions() {
      return cashierAuditActions().concat(['SALE_VOIDED', 'RETURN_PROCESSED', 'CREDIT_LIMIT_CHANGED']);
    }
    // The ACCOUNT_* entries are the deletion-lifecycle evidence trail. Two of
    // them are written by the proxy's Admin SDK, which bypasses these rules
    // entirely, so they are listed for completeness rather than necessity --
    // but ACCOUNT_ACCESS_DURING_GRACE is written by the owner's own client
    // while the tenant is frozen, and omitting it broke exactly that (caught
    // by tests/rules-deletion.test.mjs, which is the point of that test).
    function ownerAuditActions() {
      return managerAuditActions().concat(
        ['PRODUCT_CREATED', 'PRODUCT_EDITED', 'PRODUCT_DELETED', 'STORE_CURRENCY_CHANGED', 'STORE_ARCHIVED',
         'ACCOUNT_DELETION_REQUESTED', 'ACCOUNT_DELETION_CANCELLED', 'ACCOUNT_ACCESS_DURING_GRACE',
         'VAT_REGISTRATION_ENABLED', 'VAT_REGISTRATION_DISABLED']);
    }

    // The union of every field the 12 auditLogs write sites in app.js emit.
    // Closed deliberately: adding an audit field is a schema decision that
    // should be made here as well as in the client, and
    // tests/rules-audit-log.test.mjs fails if the two disagree.
    function auditLogFields() {
      return ['action', 'uid', 'createdAt',
              'saleId', 'refundAmount', 'itemCount', 'total', 'saleTotal',
              'customerId', 'customerName', 'amount', 'method', 'storeId',
              'previousLimit', 'newLimit', 'limit', 'previousBalance', 'projectedTotal', 'authorised',
              'productId', 'name', 'sellingPrice', 'qtyAdded',
              'previousCode', 'newCode',
              'vrn', 'previouslyRegistered', 'storeCount', 'reason',
              'paymentMethod', 'discountType', 'discountAmount'];
    }

    function auditStringsBounded() {
      let d = request.resource.data;
      return (!('name' in d) || (d.name is string && d.name.size() <= 120))
        && (!('vrn' in d) || (d.vrn is string && d.vrn.size() <= 20))
        && (!('reason' in d) || (d.reason is string && d.reason.size() <= 40))
        && (!('customerName' in d) || (d.customerName is string && d.customerName.size() <= 120))
        && (!('method' in d) || (d.method is string && d.method.size() <= 40))
        && (!('paymentMethod' in d) || (d.paymentMethod is string && d.paymentMethod.size() <= 40))
        && (!('discountType' in d) || (d.discountType is string && d.discountType.size() <= 40))
        && (!('previousCode' in d) || (d.previousCode is string && d.previousCode.size() <= 8))
        && (!('newCode' in d) || (d.newCode is string && d.newCode.size() <= 8))
        && (!('saleId' in d) || (d.saleId is string && d.saleId.size() <= 120))
        && (!('customerId' in d) || (d.customerId is string && d.customerId.size() <= 120))
        && (!('productId' in d) || (d.productId is string && d.productId.size() <= 120))
        && (!('storeId' in d) || (d.storeId is string && d.storeId.size() <= 120));
    }

    function validAuditLog(allowedActions) {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.action is string
        && d.action in allowedActions
        && d.keys().hasOnly(auditLogFields())
        && auditStringsBounded();
    }

    function validStore() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (!('archived' in d) || d.archived is bool)
        && (!('currencyCode' in d) || (d.currencyCode is string && d.currencyCode.matches('^[A-Z]{3}$')))
        // VAT registration is a BUSINESS fact, denormalised onto every store
        // for the same reason currencyCode is: the owner document is
        // owner-read-only, and a cashier's till has to know whether it is
        // charging VAT. The store doc is already loaded before the POS renders,
        // so this arrives with data the till already waits for rather than
        // adding a subscription that could fail on the sale path.
        // setVatRegistration() writes every store in one batch to stop the
        // copies drifting.
        && (!('vatRegistered' in d) || d.vatRegistered is bool)
        && (!('vrn' in d) || (d.vrn is string && d.vrn.size() <= 20))
        && (!('tin' in d) || (d.tin is string && d.tin.size() <= 20))
        && (!('vatEnabledAt' in d) || d.vatEnabledAt is timestamp);
    }

    function validStaff() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('archived' in d) || d.archived is bool);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        // A client may never self-assign a deletion state on creation either.
        && !('status' in request.resource.data)
        && !('deletedAt' in request.resource.data)
        && !('deletionScheduledFor' in request.resource.data);
      // The deletion-lifecycle fields are Admin-SDK-only. If a client could
      // write `status` it could freeze its own tenant, or -- far worse --
      // clear `pending_deletion` to escape the grace period and un-schedule a
      // purge. Unchanged-comparison rather than absence, so a merge write that
      // legitimately carries the existing value still succeeds.
      // role stays immutable for the reason given in ensureUserProfile().
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        && request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null)
        && request.resource.data.get('deletionScheduledFor', null) == resource.data.get('deletionScheduledFor', null);
      allow delete: if false;

      match /products/{productId} {
        // resource == null: see the note on the same branch under /sales.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validProduct();
        allow update: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validProduct() && productImmutableFieldsUnchanged())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, resource.data.storeId) && validStockMovementUpdate()));
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      match /stores/{storeId} {
        // storeId here comes from the document path itself, not
        // resource.data -- Firestore can prove this rule per-document
        // using each doc's own ID, so no `where` clause is required for
        // this collection's list queries (unlike products/sales/etc.,
        // whose storeId lives in the document body -- see the query-side
        // filtering added around resolveQueryStoreIds() in app.js).
        allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, storeId));
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validStore();
        allow update: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validStore())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, storeId) && validShiftPointerUpdate()));
        allow delete: if false;
      }

      match /staff/{staffId} {
        // Read opened to manager/cashier (Phase 3): staff need this list to
        // select their own name in POS. Write stays owner-only -- adding or
        // removing a cashier-name entry is still an owner action.
        // isOwnerOrRole() short-circuits on isOwner(), so no separate owner
        // branch is needed here either.
        allow read: if isOwnerOrRole(userId, ["manager", "cashier"]);
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validStaff();
        allow update: if isOwner(userId) && tenantNotFrozen(userId) && validStaff();
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      // RBAC (Phase 2): members/{staffUid} docs are the source of truth for
      // role/store access (see memberDocPath() etc. above). Only the owner
      // may write these directly. A staff member may read their OWN doc
      // (needed so the client can show them their own role/store scope in
      // the UI), but never another member's doc, and never write to any
      // member doc themselves -- role/store escalation must only ever
      // happen through the proxy's accept-invite endpoint (Admin SDK),
      // never via a direct client write, even by the staff member it
      // concerns.
      match /members/{staffUid} {
        allow read: if isOwner(userId) || (signedIn() && request.auth.uid == staffUid);
        allow write: if isOwner(userId) && tenantNotFrozen(userId);
      }

      match /sales/{saleId} {
        function validVoidUpdate() {
          let before = resource.data;
          let after = request.resource.data;
          return before.voided == false
            && after.voided == true
            && after.voidedAt is timestamp
            && after.items == before.items
            && after.total == before.total
            && after.paymentMethod == before.paymentMethod
            && after.cashTendered == before.cashTendered
            && after.changeDue == before.changeDue
            && after.branchId == before.branchId
            && after.cashierUid == before.cashierUid
            && after.createdAt == before.createdAt
            && (!('storeId' in before) || after.storeId == before.storeId)
            && (!('staffId' in before) || after.staffId == before.staffId)
            && (!('orderNumber' in before) || after.orderNumber == before.orderNumber)
            // QA-105b. A void restores the WHOLE sale, so voiding one that has
            // already been refunded refunds it a second time by another route.
            // The client nets prior returns off the void; the rules did not look
            // at refundedAmount at all. The second clause stops the obvious way
            // around the first -- clearing the refund record on the way through.
            && before.get('refundedAmount', 0) == 0
            && after.get('refundedAmount', 0) == 0;
        }

        function validReturnUpdate() {
          let before = resource.data;
          let after = request.resource.data;
          return before.voided == false
            && after.items == before.items
            && after.total == before.total
            && after.paymentMethod == before.paymentMethod
            && after.cashTendered == before.cashTendered
            && after.changeDue == before.changeDue
            && after.voided == before.voided
            && (!('branchId' in before) || after.branchId == before.branchId)
            && (!('storeId' in before) || after.storeId == before.storeId)
            && after.cashierUid == before.cashierUid
            && after.createdAt == before.createdAt
            && (!('staffId' in before) || after.staffId == before.staffId)
            && (!('orderNumber' in before) || after.orderNumber == before.orderNumber)
            && after.returns is list && after.returns.size() <= 20
            && after.refundedAmount is number && after.refundedAmount >= 0 && after.refundedAmount <= after.total
            // QA-105a. Bounded is not the same as monotonic. Refund the full
            // total, write refundedAmount: 0 with an empty returns array, and
            // refund it again -- indefinitely. The client caps by what has
            // already been returned, but the client is not the boundary, and an
            // insider with a manager account and a REST client is exactly who
            // this collection is guarded against. Proven exploitable against the
            // emulator before this line existed.
            && after.refundedAmount >= before.get('refundedAmount', 0)
            && after.returns.size() >= before.get('returns', []).size();
        }

        // A get() on a document that does not exist yields resource == null, and
        // reading a field off it makes the whole condition false rather than
        // erroring loudly. Completing a sale reads its own target id first, so a
        // retry resolves to the same path and cannot record the sale twice --
        // and on the normal path that read lands on a document that does not
        // exist yet. Without this branch every cashier and manager sale died at
        // the till with permission-denied; the owner never saw it because
        // isOwner short-circuits first. What a staff member can learn from the
        // null case is whether an id exists, never any content: an existing
        // document is still gated on their store access.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validSale()
          && (isOwner(userId) || memberSellsInStore(userId, request.resource.data.storeId));
        // Managers may void a full sale or process an itemized return, but
        // only for a store assigned to them -- owner reasoning revisited:
        // the owner isn't always on-site, and a manager already holds the
        // same trust level for returns. A void still has no itemized trail
        // (unlike a return, which is capped at the sale total and logged
        // per item), so this remains the single highest-trust write in the
        // schema; it's opened to managers only, never cashiers.
        allow update: if tenantNotFrozen(userId) && ((isOwner(userId) && (validVoidUpdate() || validReturnUpdate()))
          || (isOwnerOrRole(userId, ["manager"])
            && memberCanAccessStore(userId, resource.data.storeId)
            && (validVoidUpdate() || validReturnUpdate())));
        allow delete: if false;
      }

     match /customers/{customerId} {
        function validCustomer() {
          let d = request.resource.data;
          // QA-126. Every other name in this schema requires size() > 0; this one
          // did not, so a customer could be created with no name at all and then
          // appear in the receivables report as a blank row nobody can chase.
          return d.name is string && d.name.size() > 0 && d.name.size() <= 80
            && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
            && d.balanceOwed is number && d.balanceOwed >= 0
            && d.storeId is string && d.storeId.size() > 0
            && (!('oldestUnpaidAt' in d) || d.oldestUnpaidAt == null || d.oldestUnpaidAt is timestamp)
            && (!('creditLimit' in d) || d.creditLimit == null || (d.creditLimit is number && d.creditLimit >= 0));
        }
        // Cashier-safe: a credit sale (or recording a payment) only ever
        // touches balanceOwed/oldestUnpaidAt -- diff-checked so a cashier
        // write can't sneak in a creditLimit or name change alongside it.
        function validCustomerBalanceUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceOwed', 'oldestUnpaidAt', 'updatedAt'])
            && request.resource.data.balanceOwed is number && request.resource.data.balanceOwed >= 0;
        }
        // Credit limit is a manager/owner judgment call, not a cashier one.
        function validCustomerLimitUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditLimit']);
        }
        // resource == null: see the note on the same branch under /sales.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validCustomer())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, request.resource.data.storeId) && validCustomer()));
        allow update: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validCustomer())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, resource.data.storeId) && validCustomerBalanceUpdate())
          || (isOwnerOrRole(userId, ["manager"]) && memberCanAccessStore(userId, resource.data.storeId) && validCustomerLimitUpdate()));
        allow delete: if false;

        match /payments/{paymentId} {
          function validPayment() {
            let d = request.resource.data;
            return d.amount is number && d.amount > 0 && d.amount <= 1000000000000
              && (!('note' in d) || (d.note is string && d.note.size() <= 200));
          }
          allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, get(/databases/$(database)/documents/users/$(userId)/customers/$(customerId)).data.storeId));
          allow create: if tenantNotFrozen(userId) && (
               (isOwner(userId) && validPayment())
            || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, get(/databases/$(database)/documents/users/$(userId)/customers/$(customerId)).data.storeId) && validPayment()));
          allow update, delete: if false;
        }
      }

      // A shift is one till, one person, one stretch of time: opened with a
      // float, closed with a physical count, and carrying the difference
      // between what the system expected and what was actually there.
      //
      // Only one shift may be open per store at a time. Rules cannot express
      // that on their own, so the store document carries a currentShiftId
      // pointer and both open and close run as transactions against it --
      // see validShiftPointerUpdate above.
      match /shifts/{shiftId} {
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validShiftOpen())
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && memberCanAccessStore(userId, request.resource.data.storeId)
              && validShiftOpen()));
        // A cashier closes the drawer they opened, and no one else's. One shift
        // is open per till rather than per person, so without this any cashier
        // rostered to the store could count and close a colleague's drawer --
        // both uids were recorded, but a shortfall then belonged to two people
        // at once, and the closing cash figures come from the client (L-1 in
        // KNOWN-LIMITATIONS.md), so that is the wrong pair of hands to leave it
        // in.
        //
        // Managers and the owner may close any shift at a store they can reach.
        // That is the escape hatch, not a loophole: a cashier who goes home
        // without closing would otherwise strand the till, because
        // currentShiftId stays set and no new shift can open behind it.
        allow update: if tenantNotFrozen(userId) && validShiftClose() && (
             isOwner(userId)
          || (memberRole(userId) == "manager"
              && memberCanAccessStore(userId, resource.data.storeId))
          || (memberRole(userId) == "cashier"
              && memberCanAccessStore(userId, resource.data.storeId)
              && resource.data.openedByUid == request.auth.uid));
        // A reconciliation record that can be removed is not a record.
        allow delete: if false;
      }

      // The stock ledger (L-2). One append-only document per movement of
      // stock, written in the same transaction as the movement itself.
      //
      // F-4 records that rules cannot bind a stock decrement to a sale: they
      // authorise one write at a time and cannot see the sale document created
      // alongside. That stays true here -- a client can still decline to write
      // the ledger entry. What changes is that declining becomes VISIBLE.
      //
      // The mechanism is quantityBefore/quantityAfter. Each entry records the
      // shelf on both sides of the movement, and the rule below requires them
      // to agree with the delta. So the ledger is a chain: replayed forward, the
      // last quantityAfter for a product must equal that product's current
      // quantity. Stock that moved without an entry leaves a gap between the
      // two, and the gap is exactly the amount that went missing. That is a
      // detective control, which is all F-4 ever claimed was reachable -- but
      // it is one an owner can read, rather than one that requires a physical
      // stocktake to notice.
      //
      // Append-only and owner-read, like auditLogs: staff write what they did
      // and cannot read the collection back or tidy it afterwards. Bounded so a
      // loop cannot write unbounded documents.
      match /stockMovements/{movementId} {
        // An entry made offline cannot honestly carry the chain (L-9, phase A).
        //
        // quantityBefore is read from a cache that may be stale by the time a
        // queued write lands. Recording it anyway would produce a chain that
        // does not match the shelf, and reconcileProductStock() would report
        // that difference as unaccounted stock -- the anti-theft control
        // accusing a cashier for every sale made during an outage.
        //
        // So an offline entry states LESS rather than something false: the
        // delta, which is always known, and nothing about the shelf either side
        // of it. The reconciliation treats such products as unknown until their
        // next online movement re-anchors the chain.
        //
        // The two shapes are mutually exclusive and both are enforced. An entry
        // may not claim to be offline while carrying a chain (that would be a
        // guess wearing the authority of a measurement), and it may not omit the
        // chain without saying why.
        function movementIsOffline() {
          return 'offline' in request.resource.data && request.resource.data.offline == true;
        }

        function validMovementShape() {
          let d = request.resource.data;
          return movementIsOffline()
            ? (!('quantityBefore' in d) && !('quantityAfter' in d))
            : (stockCountInRange(d.quantityBefore)
               && stockCountInRange(d.quantityAfter)
               // The chain link. Without this an entry could claim any
               // resulting shelf and the replay would agree with whatever it
               // was told.
               && d.quantityAfter == d.quantityBefore + d.delta);
        }

        function validStockMovement() {
          let d = request.resource.data;
          return d.productId is string && d.productId.size() > 0 && d.productId.size() <= 120
            && d.storeId is string && d.storeId.size() > 0 && d.storeId.size() <= 120
            && d.reason in ['sale', 'restock', 'return', 'void', 'transfer-in', 'transfer-out', 'adjustment']
            && d.delta is number && d.delta >= -1000000 && d.delta <= 1000000
            && (!('offline' in d) || d.offline is bool)
            && validMovementShape()
            && d.uid == request.auth.uid
            && (!('productName' in d) || (d.productName is string && d.productName.size() <= 120))
            && (!('saleId' in d) || (d.saleId is string && d.saleId.size() <= 120))
            && (!('transferId' in d) || (d.transferId is string && d.transferId.size() <= 120))
            && (!('staffName' in d) || (d.staffName is string && d.staffName.size() <= 80));
        }
        allow read: if isOwner(userId);
        allow create: if tenantNotFrozen(userId)
          && isOwnerOrRole(userId, ["manager", "cashier"])
          && validStockMovement()
          && (isOwner(userId) || memberCanAccessStore(userId, request.resource.data.storeId));
        // A ledger that can be edited or removed is not a ledger.
        allow update, delete: if false;
      }

      match /transfers/{transferId} {
        function validTransfer() {
          let d = request.resource.data;
          return d.productId is string && d.productId.size() > 0
            && d.productName is string && d.productName.size() <= 120
            && countInRange(d.quantity) && d.quantity > 0
            && d.sourceStoreId is string && d.sourceStoreId.size() > 0
            && d.destinationStoreId is string && d.destinationStoreId.size() > 0
            // QA-127. A transfer to itself writes two ledger entries that cancel,
            // so the shelf is unchanged and the chain gains two entries describing
            // a movement that never happened.
            && d.sourceStoreId != d.destinationStoreId
            && d.staffName is string && d.staffName.size() > 0 && d.staffName.size() <= 80
            && (!('destinationProductId' in d) || (d.destinationProductId is string && d.destinationProductId.size() > 0))
            && (!('sourceStoreName' in d) || (d.sourceStoreName is string && d.sourceStoreName.size() <= 60))
            && (!('destinationStoreName' in d) || (d.destinationStoreName is string && d.destinationStoreName.size() <= 60))
            && d.performedByUid == request.auth.uid;
        }
        allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && (memberCanAccessStore(userId, resource.data.sourceStoreId) || memberCanAccessStore(userId, resource.data.destinationStoreId)));
        allow create: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validTransfer())
          || (isOwnerOrRole(userId, ["manager"]) && validTransfer()
              && memberCanAccessStore(userId, request.resource.data.sourceStoreId)
              && memberCanAccessStore(userId, request.resource.data.destinationStoreId)));
        allow update, delete: if false;
      }

      // Client faults, so a shop breaking is something the owner can see rather
      // than something they have to phone about. 73 console.warn calls existed
      // before this and every one of them landed in a browser console on a
      // phone nobody will ever open.
      //
      // Append-only and owner-read: staff write what broke in front of them but
      // cannot read the collection back or tidy it afterwards. Bounded fields
      // so a loop cannot write unbounded documents, and no field here is meant
      // to carry customer data -- the client strips what looks like a phone
      // number or an email before sending.
      match /errorLog/{entryId} {
        function validErrorEntry() {
          let d = request.resource.data;
          return d.message is string && d.message.size() > 0 && d.message.size() <= 300
            && d.uid == request.auth.uid
            && (!('where' in d) || (d.where is string && d.where.size() <= 200))
            && (!('kind' in d) || d.kind in ['error', 'rejection'])
            && (!('storeId' in d) || d.storeId == null || (d.storeId is string && d.storeId.size() <= 64))
            && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 40));
        }
        allow read: if isOwner(userId);
        // isOwnerOrRole() already short-circuits on isOwner(), so the owner
        // needs no separate branch here -- and spelling one out suggested a
        // distinction that does not exist.
        allow create: if tenantNotFrozen(userId)
          && isOwnerOrRole(userId, ["manager", "cashier"])
          && validErrorEntry();
        // A fault report that can be edited or removed is not a report.
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        // Deliberately NOT gated on tenantNotFrozen(). A frozen tenant must
        // still be able to record what happened to it -- the deletion request
        // itself, the restore, and any access attempt during the grace period
        // are exactly the events an erasure audit needs. Freezing the audit
        // log would destroy the evidence trail for the deletion it is meant
        // to document. Entries remain append-only regardless.
        allow read: if isOwner(userId);
        // One branch per role rather than a single role list, because the set
        // of actions each may record differs -- see validAuditLog above.
        allow create: if (isOwner(userId) && validAuditLog(ownerAuditActions()))
          || (memberRole(userId) == "manager" && validAuditLog(managerAuditActions()))
          || (memberRole(userId) == "cashier" && validAuditLog(cashierAuditActions()));
        allow update, delete: if false;
      }

      match /monthlyReports/{reportId} {
        function validMonthlyReport() {
          let d = request.resource.data;
          return d.storeId is string && d.storeId.size() > 0
            && d.periodLabel is string && d.periodLabel.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && d.periodStart is timestamp && d.periodEnd is timestamp
            && d.generatedBy == request.auth.uid
            && d.metrics is map
            && d.aiSummary is string && d.aiSummary.size() <= 6000;
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validMonthlyReport();
        allow update: if isOwner(userId) && tenantNotFrozen(userId) && validMonthlyReport();
        allow delete: if false;
      }

      // Per-business override-password hash (Phase 9). No client may read or
      // write this directly, not even the doc's own owner -- if it were
      // readable, the owner's own browser could fetch the hash and brute-
      // force it offline, defeating server-side verification entirely. Only
      // the proxy's Firebase Admin SDK (which bypasses these rules) may
      // touch it, via POST /api/settings/override-password and
      // POST /api/ai/override-verify in proxy/server.js.
      match /private/security {
        allow read, write: if false;
      }
    }
  }
}
