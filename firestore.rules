rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // RBAC (Phase 1): members/{staffUid} docs live under the owner's own
    // users/{ownerUid} tree -- no data restructuring needed. A get() lookup
    // (not a custom claim) is the source of truth for role/store access so
    // that disabling a staff member takes effect on their very next request,
    // not after their ID token happens to expire.
    function memberDocPath(ownerUid) {
      return /databases/$(database)/documents/users/$(ownerUid)/members/$(request.auth.uid);
    }

    function isActiveMember(ownerUid) {
      return signedIn()
        && exists(memberDocPath(ownerUid))
        && get(memberDocPath(ownerUid)).data.status == "active";
    }

    function memberRole(ownerUid) {
      return isActiveMember(ownerUid) ? get(memberDocPath(ownerUid)).data.role : null;
    }

    function memberStoreIds(ownerUid) {
      return isActiveMember(ownerUid) ? get(memberDocPath(ownerUid)).data.storeIds : [];
    }

    // "all" is an explicit opt-in for a member who should see every branch
    // (e.g. a roaming manager) -- absent that, a member only reaches the
    // specific storeIds assigned to them.
    function memberCanAccessStore(ownerUid, storeId) {
      let ids = memberStoreIds(ownerUid);
      return ("all" in ids) || (storeId in ids);
    }

    function isOwnerOrRole(ownerUid, roles) {
      return isOwner(ownerUid) || memberRole(ownerUid) in roles;
    }

    // Deletion lifecycle, phase 1 (see SECURITY-AUDIT.md F-1 and
    // DATA-DELETION.md). Once an owner requests deletion their tenant is
    // frozen read-only for a 30-day grace period: existing data stays
    // readable so they can review it and self-serve a restore, but nothing
    // new may be written. Only the proxy's Admin SDK can set or clear this
    // status -- no client can, because users/{userId} update forbids
    // changing it (see the users match block).
    //
    // A missing users/{userId} doc is treated as active: a brand-new signup
    // writes its first store before its profile document exists, and an
    // absent profile must not read as "frozen".
    //
    // Applied to WRITES only, deliberately. Every get() inside a rule is a
    // billed read, and reads outnumber writes heavily in a POS. Immediate
    // read lockout for STAFF is handled instead by the proxy disabling their
    // Firebase Auth accounts and revoking refresh tokens at request time,
    // which is both free and faster-acting than any rule.
    function tenantNotFrozen(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId))
        || get(/databases/$(database)/documents/users/$(userId)).data.get('status', 'active') != 'pending_deletion';
    }

    // Upper bounds on every number written here.
    //
    // These existed only as `>= 0`, which let two things through. Infinity
    // satisfies both `is number` and `>= 0`, so a price or a quantity of
    // Infinity was accepted -- and once stored, every total and report that
    // touches the row is Infinity too, with no arithmetic that recovers it.
    // Values above 2^53 were also accepted and silently lose integer
    // precision: 9007199254740993 stores as 9007199254740992, so a stock
    // count is quietly wrong rather than visibly rejected. Both were measured
    // against these rules, not assumed.
    //
    // The ceilings are deliberately far above any real shop. They exist to
    // keep arithmetic exact, not to judge what a business may sell. In TZS a
    // billion is roughly USD 380,000 for a single unit. The sale ceiling is
    // set so 40 lines (the item cap) at the per-line maxima still land well
    // inside the safe-integer range.
    //
    // The client mirrors these in app.js and rejects with a readable message
    // first; tests/validation-limits.test.mjs fails if the two ever disagree.
    function countInRange(v) {
      return v is number && v >= 0 && v <= 1000000;
    }

    // Stock on a shelf, which may legitimately be negative (L-9, phase A).
    //
    // Everything else counted here stays non-negative: a reorder level, a
    // number of units sold, a transfer quantity. A shelf is different. Once
    // offline selling exists a cashier can sell stock the cached count said was
    // there and the server already knew was gone, and the agreed policy is to
    // take the sale and flag it rather than refuse a paying customer.
    //
    // Without this, that sale is rejected at REPLAY time -- silently, hours
    // later, after the customer has left and the money is in the drawer. A
    // guard that discards completed sales without telling anyone is worse than
    // the negative number it was protecting against.
    //
    // Negative stock is a signal, not corruption: it means more was sold than
    // the system believed was there, which is exactly what an owner needs to
    // see. It is still bounded, so a typo or a loop cannot write nonsense.
    function stockCountInRange(v) {
      return v is number && v >= -1000000 && v <= 1000000;
    }
    function moneyInRange(v) {
      return v is number && v >= 0 && v <= 1000000000;
    }
    // Variance is counted minus expected, so it is negative exactly when the
    // drawer is short -- the case the whole feature exists to surface. The
    // unsigned helpers above would reject precisely the shifts worth reading.
    function signedMoneyInRange(v) {
      return v is number && v >= -1000000000 && v <= 1000000000;
    }

    function totalInRange(v) {
      return v is number && v >= 0 && v <= 1000000000000;
    }

    function validProduct() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.category is string && d.category.size() <= 60
        && d.brand is string && d.brand.size() <= 60
        && d.supplier is string && d.supplier.size() <= 60
        && stockCountInRange(d.quantity)
        && d.storeId is string && d.storeId.size() > 0
        && (!('barcode' in d) || (d.barcode is string && d.barcode.size() <= 64))
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && (!('warehouse' in d) || (d.warehouse is string && d.warehouse.size() <= 60))
        && (!('shelf' in d) || (d.shelf is string && d.shelf.size() <= 60))
        && (!('sku' in d) || (d.sku is string && d.sku.size() <= 40))
        // Spec 4.1. Both optional: every product the eight live shops hold
        // predates them, and absent `active` must read as ACTIVE or their whole
        // catalogue would disappear from the till at once.
        && (!('unit' in d) || (d.unit is string && d.unit.size() <= 20))
        && (!('active' in d) || d.active is bool)
        // STAGE 2, RESTORED 2026-09-07. Cost is refused on a product document
        // outright, which is what DESIGN-purchases.md 10 always specified.
        //
        // The migration ran the same day: `proxy/migrate-strip-product-cost.mjs
        // --apply` removed the field from 556 documents across 13 tenants, and
        // `--verify` reports 734 tenant products carrying none. Every one of the
        // 556 held `costPrice: 0` and none held `costKnownFrom` -- the legacy
        // zero the deployed client wrote in a loop, never a real cost -- so
        // nothing of value was removed and nothing needs backfilling.
        //
        // THE ORDERING THIS DEPENDS ON, and it is not optional: production must
        // already be serving a client that does not write the field. It is
        // (20260823d, verified by fetching the live app.js and reading it: every
        // costPrice write targets /productCostHistory or /productCosts, and the
        // product form's numericFields loop no longer contains it). Deploying
        // this ahead of such a client breaks Add Product, Edit Product and every
        // owner-driven stock decrement -- i.e. selling -- because an update is
        // validated against the RESULTING document. Staff selling would be
        // unaffected, so it presents as "the owner cannot sell but the till
        // can", which is not a hypothesis anyone reaches quickly.
        //
        // If an old client is ever found still writing it, re-run --verify: a
        // count that has gone dirty again means the writer is still out there,
        // and this pair of lines goes back to the stage-1 tolerance below.
        //     && (!('costPrice' in d) || moneyInRange(d.costPrice))
        //     && (!('costKnownFrom' in d) || d.costKnownFrom is timestamp)
        //
        // Cost belongs in /productCosts, which a cashier cannot read at all:
        // Firestore has no field-level read security and a cashier's POS reads
        // /products in full, so any cost on THIS document is a cost every
        // cashier can read. That is what DESIGN-purchases.md 10 exists to
        // prevent, and the destination is still an outright refusal.
        //
        // The other half of the guarantee was never relaxed even under stage 1:
        // a cashier or manager cannot put cost on a product, because that
        // refusal comes from stockMovementKeys() via validStockMovementShape(),
        // which allows only quantity, sold30, sold90, updatedAt and
        // movementReason. This clause closes the remaining hole -- the owner's
        // own writes -- so cost cannot reach a product document by any path.
        //
        // See KNOWN-LIMITATIONS.md L-15 for the whole two-stage account.
        && !('costPrice' in d)
        && !('costKnownFrom' in d)
        && (!('sellingPrice' in d) || moneyInRange(d.sellingPrice))
        && (!('reorderLevel' in d) || countInRange(d.reorderLevel))
        && (!('expiryDate' in d) || (d.expiryDate is string && d.expiryDate.size() <= 10))
        // Absent means standard-rated, which is what taxClassOf() defaults to.
        // Defaulting the other way would silently under-collect on every
        // product added before this field existed.
        && (!('taxClass' in d) || d.taxClass in ['standard', 'zeroRated', 'exempt']);
    }

    // A service is a sellable thing with a price and no shelf: a haircut, a
    // plate of food. See DESIGN-services.md.
    //
    // Deliberately NOT a product with quantity 0. validProduct() requires
    // stockCountInRange(d.quantity) on every write, and a service has no
    // quantity -- not zero, none. Zero would be actively wrong: stockStatus()
    // reads it as permanently out of stock, every low-stock and reorder
    // surface would carry it, and reconcileProductStock() would try to explain
    // a shelf count that never existed.
    //
    // Mirrors validProduct() where the fields genuinely correspond, so the two
    // stay legible side by side, and omits the four that only mean something
    // for stock: quantity, reorderLevel, expiryDate, sku.
    // DESIGN-purchases.md 8.1. Deliberately flat and constant-cost: no
    // iteration, no per-item unrolling. The file already records what happened
    // when validSaleItem() was unrolled across 40 slots, and every validator
    // added from here on has to stay cheap for the same reason.
    // DESIGN-purchases.md 3. One document per batch bought. The BATCH is the
    // record: quantity and what was actually paid for it. unitCost is derived
    // and deliberately not rounded -- 100 items for 33,333 is 333.33 each, and
    // storing 333 loses 33 shillings against the invoice on every delivery,
    // forever. moneyInRange() has no integer requirement, so the fraction is
    // already legal.
    //
    // Flat and constant-cost, like validExpense(): no iteration, no per-item
    // unrolling. This is also why a purchase is one product per delivery rather
    // than a multi-line supplier invoice -- see section 1.
    // The weighted-average cost of one product, kept off the product document
    // so a cashier cannot read it. Document id is the productId, so the restock
    // transaction can read it directly without a query.
    // One record per change to a product's weighted average, carrying the moment
    // that average took effect. Profit for a sale is then quantity x the cost in
    // force on the sale's own date, which is historically exact and cannot be
    // rewritten by a later delivery.
    //
    // This exists INSTEAD of a unitCost on each sale line, which is what
    // DESIGN-purchases.md section 5 originally specified. That is not buildable
    // here: the till is operated by a cashier, a cashier cannot read
    // /productCosts, and a cashier CAN read sales -- so the line would be both
    // unwritable and, if written, readable by exactly the role cost was moved
    // away from. Section 13f records the decision.
    //
    // Append-only. A history that can be edited is not a history, and the whole
    // value of this collection is that a record of what cost applied in July
    // still says so in December.
    function validProductCostHistory() {
      let d = request.resource.data;
      return d.keys().hasOnly(['productId', 'storeId', 'costPrice', 'effectiveFrom', 'reason', 'createdAt'])
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 120
        && d.storeId is string && d.storeId.size() > 0 && d.storeId.size() <= 120
        && moneyInRange(d.costPrice)
        && d.effectiveFrom is timestamp
        && d.createdAt is timestamp
        // A closed set, so the history says WHY the average moved. Both are
        // stock arriving; nothing else changes a weighted average.
        && d.reason in ['purchase', 'transfer-in'];
    }

    function validProductCost() {
      let d = request.resource.data;
      return d.keys().hasOnly(['storeId', 'costPrice', 'costKnownFrom', 'updatedAt'])
        && d.storeId is string && d.storeId.size() > 0 && d.storeId.size() <= 120
        && moneyInRange(d.costPrice)
        // Required, not optional. A cost document that exists at all is a
        // statement that cost became knowable at some moment, and every profit
        // surface reads that moment to decide whether a period can report a
        // complete margin. DESIGN-purchases.md 4.3.
        && d.costKnownFrom is timestamp;
    }

    // costKnownFrom is stamped once by the first purchase and never moves after.
    // Left mutable, a manager could back-date it and every profit surface would
    // then believe cost had been known since before the shop recorded any --
    // reporting a confident margin against stock nobody costed.
    function productCostImmutableFieldsUnchanged() {
      return request.resource.data.storeId == resource.data.storeId
        && request.resource.data.costKnownFrom == resource.data.costKnownFrom;
    }

    // Shape only. The recorder pin lives in validPurchaseCreate() below, because
    // asserting it on UPDATE made owner corrections impossible: the shape said
    // recordedByUid must be the caller, the immutability guard said it must not
    // change, and for any manager-recorded document those two cannot both hold.
    // The owner could correct only their own entries, and a manager's were
    // frozen -- the exact inverse of the control section 10 describes.
    function validPurchase() {
      let d = request.resource.data;
      return d.keys().hasOnly(['storeId', 'productId', 'productName', 'quantity',
                               'totalPaid', 'unitCost', 'recordedByUid', 'createdAt',
                               'supplierName', 'supplierTin', 'receiptNumber',
                               'receiptDate', 'hasFiscalReceipt', 'note',
                               // DESIGN-landed-costs.md 3. All three optional:
                               // every purchase written before this design has
                               // none of them, and the restock and product-form
                               // paths still write none. Absent reads as
                               // goodsCost == totalPaid and landedCost == 0,
                               // which is exactly true of a delivery that had no
                               // additional costs.
                               'deliveryId', 'goodsCost', 'landedCost',
                               // The VAT printed on the supplier's fiscal
                               // receipt. DESIGN-vat.md: captured, not derived
                               // -- 18/118 assumes the whole basket was
                               // standard-rated, and a great deal of Tanzanian
                               // food is exempt, so deriving it would overstate
                               // a CLAIM. That is the direction that earns a
                               // penalty rather than a refund.
                               'vatAmount',
                               // DESIGN-suppliers-purchases.md 4.3. Optional,
                               // like deliveryId above and for the same reason:
                               // every purchase the eight live shops have ever
                               // written carries only the free-text
                               // supplierName. Absent means "typed, not picked",
                               // and reports fall back to the name so history
                               // does not split into two suppliers.
                               'supplierId'])
        && d.storeId is string && d.storeId.size() > 0 && d.storeId.size() <= 120
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 120
        && d.productName is string && d.productName.size() > 0 && d.productName.size() <= 120
        // Strictly positive on both. A delivery of nothing is not a purchase,
        // and a free delivery is not a cost -- either is a mis-key, and either
        // would divide by zero or drag the average to nothing.
        // Whole units. A fractional delivery count is nonsense against an
        // integer shelf, and the client already floors it.
        && d.quantity is number && d.quantity > 0 && d.quantity <= 1000000
        && math.floor(d.quantity) == d.quantity
        && d.totalPaid is number && d.totalPaid > 0 && d.totalPaid <= 1000000000
        // Strictly positive, not merely in range. The tolerance below is
        // absolute, so at totalPaid == 1 a unitCost of 0 satisfies it -- a
        // million units at no cost each, which is exactly what the totalPaid > 0
        // guard above was written to refuse. quantity <= 1,000,000 and
        // totalPaid > 0 make a genuine unit cost at least 1e-6, so nothing real
        // is excluded.
        && d.unitCost is number && d.unitCost > 0 && d.unitCost <= 1000000000
        // The invariant the whole feature is judged on: what was paid must agree
        // with what the batch says each unit cost.
        //
        // Within a shilling, NOT exactly. unitCost is totalPaid/quantity kept
        // unrounded on purpose, so it is routinely a repeating fraction -- 33,333
        // over 100 units is 333.33..., and 333.33 * 100 is 33332.999999999996 in
        // float64. An equality test here would refuse a perfectly ordinary
        // delivery and take the restock transaction down with it, which is the
        // shape of outage this file exists to prevent. The tolerance is orders of
        // magnitude above the representation error (~1e-7 at the top of
        // moneyInRange) and far below any figure a human would mis-key.
        && d.unitCost * d.quantity >= d.totalPaid - 1
        && d.unitCost * d.quantity <= d.totalPaid + 1
        && d.recordedByUid is string && d.recordedByUid.size() > 0
        // The Purchase Book buckets on this. Left unvalidated a delivery could
        // arrive with no date and appear in no month at all -- invisible in the
        // book while its cost had already moved the product's average -- or with
        // a string, or back-dated into a period already reported on.
        && d.createdAt is timestamp
        && (!('supplierName' in d) || (d.supplierName is string && d.supplierName.size() <= 120))
        && (!('supplierTin' in d) || (d.supplierTin is string && d.supplierTin.size() <= 20))
        // The fields that decide whether input VAT is claimable at all. The
        // six-month window runs from the FISCAL RECEIPT date, not the invoice
        // date -- RESEARCH-accounts.md 5.3 -- so a purchase recorded without
        // them loses a claim the shop was entitled to.
        && (!('receiptNumber' in d) || (d.receiptNumber is string && d.receiptNumber.size() <= 60))
        && (!('receiptDate' in d) || d.receiptDate is timestamp)
        && (!('hasFiscalReceipt' in d) || d.hasFiscalReceipt is bool)
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        // A claim can never exceed what was paid. Enforced here as well as in
        // the client because this figure is filed with a tax authority: an
        // amount above the total is a typo, and an overclaim is an underpayment.
        && (!('vatAmount' in d) || (moneyInRange(d.vatAmount) && d.vatAmount <= d.totalPaid))
        // The delivery this line belongs to. Unvalidated as a reference -- rules
        // cannot cheaply prove the header exists, and a get() here would put a
        // document read on the restock path.
        && (!('deliveryId' in d) || (d.deliveryId is string && d.deliveryId.size() > 0 && d.deliveryId.size() <= 120))
        && (!('goodsCost' in d) || moneyInRange(d.goodsCost))
        && (!('landedCost' in d) || moneyInRange(d.landedCost))
        // DESIGN-landed-costs.md 3.1: totalPaid carries the LANDED total, so the
        // split must add back up to it. Written as a pair of bounds rather than
        // an equality for the same reason the unitCost invariant above is: the
        // allocated share is an unrounded fraction and float64 does not come
        // back exact. One shilling, orders of magnitude above the representation
        // error and far below any figure a human would mis-key.
        //
        // Both-or-neither. A line carrying goodsCost alone would report its
        // landed cost as zero in the drill-down while totalPaid said otherwise,
        // which is a book disagreeing with itself.
        && (('goodsCost' in d) == ('landedCost' in d))
        && (!('goodsCost' in d) || (
               d.goodsCost + d.landedCost >= d.totalPaid - 1
            && d.goodsCost + d.landedCost <= d.totalPaid + 1));
    }

    function validPurchaseCreate() {
      return validPurchase() && request.resource.data.recordedByUid == request.auth.uid;
    }

    // A purchase is what the shop actually paid on a day. Moving it between
    // branches or reassigning who recorded it would rewrite the book, and the
    // weighted average it already fed cannot be un-fed.
    // What a delivery cost is settled at the moment it is recorded, because the
    // product's weighted average is a cached derivation computed once inside the
    // restock transaction and never recomputed. Editing quantity or totalPaid
    // afterwards leaves the book and the average permanently disagreeing, in the
    // direction that understates cost and overstates profit.
    //
    // A wrong amount is corrected by deleting the delivery and recording it
    // again -- which is why deletion is allowed, and why it is audited.
    // What stays editable is the paperwork that turns up later: supplier, TIN,
    // receipt number, receipt date, and the note.
    function purchaseImmutableFieldsUnchanged() {
      let after = request.resource.data;
      let before = resource.data;
      return after.storeId == before.storeId
        && after.productId == before.productId
        && after.productName == before.productName
        && after.quantity == before.quantity
        && after.totalPaid == before.totalPaid
        && after.unitCost == before.unitCost
        && after.recordedByUid == before.recordedByUid
        && after.createdAt == before.createdAt
        // The landed split settles with everything else it was derived from.
        // Editing it afterwards would leave the drill-down attributing money to
        // freight that the weighted average already spent as goods cost, and the
        // header's allocation would no longer reconcile to its lines.
        //
        // .get() with a sentinel rather than an `in` test on both sides: these
        // are optional, absent on every purchase written before this design, and
        // reading a missing field directly is an error rather than a null. -1 is
        // outside moneyInRange, so it cannot collide with a real value.
        && after.get('deliveryId', '') == before.get('deliveryId', '')
        && after.get('goodsCost', -1) == before.get('goodsCost', -1)
        && after.get('landedCost', -1) == before.get('landedCost', -1);
    }

    // The goods received note -- DESIGN-landed-costs.md 3.
    //
    // A header document, NOT an array of lines. Every rule in this file is
    // written flat and constant-cost on purpose (see the note above
    // validExpense(), and rules-budget-probe.mjs, which exists because the
    // 1000-expression ceiling has been hit here before). Validating an unbounded
    // array of line items means iteration, and iteration is where the budget
    // goes. The lines are /purchases documents, each validated flat on its own.
    //
    // The seven additional cost types are REQUIRED, not optional -- a departure
    // from the design's first draft, decided while writing this clause. Optional
    // would mean seven `('freight' in d) ? d.freight : 0` terms to sum them, and
    // the sum has to be checked or the header's own breakdown need not add up to
    // its own total. Required-with-explicit-zeros makes the arithmetic one line
    // and costs seven zeroes on one document per delivery.
    function validDelivery() {
      let d = request.resource.data;
      return d.keys().hasOnly(['storeId', 'reference', 'supplierName', 'supplierTin',
                               'receivedAt', 'goodsCost',
                               'freight', 'importDuty', 'clearing', 'transport',
                               'handling', 'insurance', 'otherCost',
                               'additionalTotal', 'totalCost', 'allocationBasis',
                               'lineCount', 'recordedByUid', 'createdAt', 'note',
                               // Payment terms. Spec 5.1-5.3, phase 2. All
                               // OPTIONAL: deliveries shipped on 2026-09-08 and
                               // the live shops already hold header documents
                               // that carry none of these. Absent amountPaid
                               // reads as PAID IN FULL, which is what recording
                               // a delivery meant before terms existed -- the
                               // safe reading, because it claims no debt that
                               // nobody entered.
                               'supplierId', 'amountPaid', 'paymentMethod'])
        && d.storeId is string && d.storeId.size() > 0 && d.storeId.size() <= 120
        // Zero is legitimate: a delivery of free goods that still cost freight.
        // What cannot be zero is totalCost -- a delivery that cost nothing is
        // not a delivery, and it would divide by zero downstream.
        && moneyInRange(d.goodsCost)
        && moneyInRange(d.freight) && moneyInRange(d.importDuty)
        && moneyInRange(d.clearing) && moneyInRange(d.transport)
        && moneyInRange(d.handling) && moneyInRange(d.insurance)
        && moneyInRange(d.otherCost)
        && moneyInRange(d.additionalTotal)
        && d.totalCost is number && d.totalCost > 0 && d.totalCost <= 1000000000
        // You cannot pay more than the delivery cost. Overpayment is a credit
        // note against the supplier, which is a different record from this one,
        // and allowing it here would drive balanceOwed negative.
        && (!('amountPaid' in d) || (moneyInRange(d.amountPaid) && d.amountPaid <= d.totalCost))
        && (!('paymentMethod' in d) || d.paymentMethod in ['cash', 'bank', 'mobile', 'credit'])
        && (!('supplierId' in d) || (d.supplierId is string && d.supplierId.size() > 0 && d.supplierId.size() <= 120))
        // The header must add up to itself. Both to a shilling, not exactly, for
        // the reason given on the unitCost invariant above: these figures are
        // sums of unrounded allocations and float64 does not return them exact.
        && d.freight + d.importDuty + d.clearing + d.transport
           + d.handling + d.insurance + d.otherCost >= d.additionalTotal - 1
        && d.freight + d.importDuty + d.clearing + d.transport
           + d.handling + d.insurance + d.otherCost <= d.additionalTotal + 1
        && d.goodsCost + d.additionalTotal >= d.totalCost - 1
        && d.goodsCost + d.additionalTotal <= d.totalCost + 1
        // The basis ACTUALLY used, which is not always the one the screen asked
        // for: a delivery of free goods cannot be split by value and falls back
        // to quantity. A header claiming 'value' over an allocation done by
        // quantity is a book that lies about its own arithmetic.
        // 'weight' is deliberately absent -- DESIGN-landed-costs.md 2.
        && d.allocationBasis in ['value', 'quantity', 'manual']
        // Whole lines, at least one. The ceiling is arithmetic, not taste, and
        // phase 2 got it WRONG: it counted four writes a line and forgot the
        // stock movement. Receiving a line writes FIVE documents inside the
        // transaction -- the product, its cost, its cost history, the purchase
        // and the movement -- and the header and its audit entry take two more.
        // Firestore caps a transaction at 500 writes, so the old ceiling of 100
        // was 502: one over, failing only after a shop had typed in a
        // hundred-line delivery. 80 x 5 + 3 = 403, which leaves room for a sixth
        // per-line document without another rules change.
        // DELIVERY_MAX_LINES in app.js carries the same number and the same sum.
        && d.lineCount is number && d.lineCount > 0 && d.lineCount <= 80
        && math.floor(d.lineCount) == d.lineCount
        // The day the goods arrived, which is routinely not the day it was
        // typed -- the same separation spentAt makes for an expense. The Purchase
        // Book and every period report bucket on it.
        && d.receivedAt is timestamp
        && d.receivedAt < request.time + duration.value(2, 'd')
        && d.recordedByUid is string && d.recordedByUid.size() > 0
        && d.createdAt is timestamp
        && (!('reference' in d) || (d.reference is string && d.reference.size() <= 60))
        && (!('supplierName' in d) || (d.supplierName is string && d.supplierName.size() <= 120))
        && (!('supplierTin' in d) || (d.supplierTin is string && d.supplierTin.size() <= 20))
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    function validDeliveryCreate() {
      return validDelivery() && request.resource.data.recordedByUid == request.auth.uid;
    }

    // What a delivery cost is settled the moment it is recorded, for the same
    // reason a purchase is: the allocation has already been spread across the
    // lines and folded into each product's weighted average, which is a cached
    // derivation computed once and never recomputed. Editing an amount here
    // leaves the header, the lines and the averages permanently disagreeing.
    //
    // What stays editable is the paperwork that turns up later: the supplier's
    // name, their TIN, the invoice reference, and the note.
    function deliveryImmutableFieldsUnchanged() {
      let after = request.resource.data;
      let before = resource.data;
      return after.storeId == before.storeId
        && after.goodsCost == before.goodsCost
        && after.freight == before.freight
        && after.importDuty == before.importDuty
        && after.clearing == before.clearing
        && after.transport == before.transport
        && after.handling == before.handling
        && after.insurance == before.insurance
        && after.otherCost == before.otherCost
        && after.additionalTotal == before.additionalTotal
        && after.totalCost == before.totalCost
        && after.allocationBasis == before.allocationBasis
        && after.lineCount == before.lineCount
        && after.receivedAt == before.receivedAt
        && after.recordedByUid == before.recordedByUid
        && after.createdAt == before.createdAt;
    }

    // Shape only -- see the note above validPurchase() for why the recorder pin
    // is not in here.
    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasOnly(['storeId', 'category', 'amount', 'paidFrom',
                               'spentAt', 'recordedByUid', 'createdAt', 'note',
                               // DESIGN-landed-costs.md 5. Optional: every
                               // expense written before phase 5 has none, and
                               // absent reads as 'indirect' -- which is the
                               // default of all nine categories that existed
                               // then, so absent and stored agree on history.
                               'nature'])
        && d.storeId is string && d.storeId.size() > 0 && d.storeId.size() <= 120
        // Closed set, not free text. A category nobody can report on is a note,
        // and two of these carry a tax consequence later (rent withholding at
        // 10%; entertainment input VAT is not deductible, which is why there is
        // no entertainment category and such spending goes to 'other').
        //
        // The last three arrived with DESIGN-landed-costs.md 5: the docx section
        // 11 names sales commission, delivery related to a sale, and sales
        // packaging as DIRECT operating expenses, and until now they had nowhere
        // to go but 'other' -- which is the one category no report can act on.
        && d.category in ['rent', 'utilities', 'wages', 'transport',
                          'supplies', 'repairs', 'licences', 'marketing', 'other',
                          'commission', 'delivery', 'packaging']
        // Strictly positive. A zero expense is a mis-key, and a negative one is
        // income wearing the wrong hat.
        && d.amount is number && d.amount > 0 && d.amount <= 1000000000
        // Where the money physically came from. Captured from day one because
        // retrofitting it means guessing at history -- but nothing reads it yet:
        // wiring till-paid spending into shift reconciliation is its own phase,
        // and reconcileShiftCash() is not touched here.
        && d.paidFrom in ['till', 'other']
        // When the money left, which is routinely not when it was typed. A
        // period report keyed on createdAt would put last week's transport in
        // this week's total.
        && d.spentAt is timestamp
        // Not in the future. Two days of slack because spentAt is anchored at
        // LOCAL noon, which in Tanzania is 09:00 UTC -- an expense recorded at
        // 08:00 local is stamped ahead of request.time and is perfectly
        // legitimate. An offline expense replaying later is stamped in the past
        // and is unaffected.
        && d.spentAt < request.time + duration.value(2, 'd')
        && d.recordedByUid is string && d.recordedByUid.size() > 0
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        // Direct or indirect OPERATING expense -- the docx section 9 statement
        // has a line for each. Both sit below gross profit and both subtract
        // from it, so misclassifying one as the other cannot move gross profit
        // and cannot move net profit; only the split between two lines that add
        // to the same total. This is the rare money field where getting it wrong
        // is presentational, which is why it is self-classified rather than
        // derived from the category and pinned.
        //
        // A third value is NOT permitted. Inventory and landed costs are the
        // docx's third tier and they never reach this collection at all -- they
        // are capitalised into stock by the delivery path. An expense document
        // claiming to be one would be counted once in COGS and once in operating
        // expenses, understating profit by the whole of it.
        && (!('nature' in d) || d.nature in ['direct', 'indirect']);
    }

    function validExpenseCreate() {
      return validExpense() && request.resource.data.recordedByUid == request.auth.uid;
    }

    // Staff record the day's spending, not last month's. Seven days rather than
    // one because an expense typed offline replays whenever the phone next
    // connects, and a rule that refused it then would discard what the cashier
    // recorded, silently, long after they moved on. The screen offers today;
    // this is the ceiling behind it.
    function staffExpenseDateInWindow() {
      return request.resource.data.spentAt > request.time - duration.value(7, 'd');
    }

    function validService() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && moneyInRange(d.price)
        && d.storeId is string && d.storeId.size() > 0
        && (!('category' in d) || (d.category is string && d.category.size() <= 60))
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        // Absent means active. A service withdrawn from the menu is flagged
        // rather than deleted, because sales already reference it by name and
        // deleting it would leave that history describing something gone.
        && (!('active' in d) || d.active is bool)
        // Same enum and the same default as a product: absent is standard-rated,
        // per DESIGN-vat.md. Defaulting the other way would under-collect.
        && (!('taxClass' in d) || d.taxClass in ['standard', 'zeroRated', 'exempt']);
    }

    // The branch an expense was recorded against does not move, and neither
    // does who recorded it. Same reasoning as a product's storeId: allowing it
    // would silently move spending between branches on an edit.
    function expenseImmutableFieldsUnchanged() {
      return request.resource.data.storeId == resource.data.storeId
        && request.resource.data.recordedByUid == resource.data.recordedByUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function serviceImmutableFieldsUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('storeId' in resource.data) || request.resource.data.storeId == resource.data.storeId);
    }

    function productImmutableFieldsUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('storeId' in resource.data) || request.resource.data.storeId == resource.data.storeId);
    }

    // Cashier-safe stock movement: staff may move stock levels but touch
    // nothing else on the product doc -- name/price/category/etc. stay
    // owner-only edits. diff().affectedKeys() proves exactly which fields
    // changed, so this can't be widened into a general product edit.
    //
    // Covers all four client stock paths, which each write exactly this field
    // set: a sale decrements quantity and raises sold30/sold90; a restock
    // raises quantity alone; a return or void does the reverse of a sale.
    //
    // Deliberately NOT increase-only. An earlier version required
    // quantity >= resource.data.quantity, which blocked the sale path
    // outright -- the stock decrement was denied inside the same transaction
    // that created the sale, so the transaction rolled back and no cashier or
    // manager could complete a sale at all.
    //
    // Note the real limit here: rules authorize each write independently, so
    // this cannot verify that a matching sale document was created in the
    // same transaction. A cashier could therefore write down stock without a
    // corresponding sale. The compensating controls are the sale record and
    // the auditLogs entry (both required and both owner-readable), plus
    // physical stock reconciliation -- not this rule.
    // F-4. movementReason records WHY stock moved, so the owner's audit trail
    // distinguishes a sale from a restock from a return instead of showing a
    // bare number change. Only the enum is validated here.
    //
    // Direction-coupling (rejecting a "restock" that decreases stock) was
    // implemented and then deliberately removed. It could not be made both
    // correct and safe: keying off field presence meant a persisted value
    // constrained later writes that omitted the field, so a product left
    // reading "restock" rejected the next sale and took the till offline;
    // keying off diff().affectedKeys() meant consecutive sales -- the normal
    // case, same value each time -- skipped validation altogether. Both were
    // caught by tests/rules-deletion.test.mjs.
    //
    // The security value was negligible either way: someone writing stock down
    // to cover theft simply omits the field or labels it "sale". Prevention is
    // not reachable in rules, because rules authorise each write independently
    // and so cannot tie a stock decrement to a sale document created in the
    // same transaction. The real control is detective -- the sale record plus
    // the auditLogs entry, reconciled by the owner -- which is what this field
    // exists to make precise. See SECURITY-AUDIT.md F-4.
    function validMovementReason() {
      let after = request.resource.data;
      return !('movementReason' in after)
        // 'supplier-return' is goods going BACK to a supplier -- spec 4.2 lists
        // it as its own decrease class, distinct from 'return' (a customer
        // bringing goods back, which INCREASES stock). Labelling one as the
        // other would make the ledger read backwards.
        || after.movementReason in ['sale', 'restock', 'return', 'void', 'supplier-return'];
    }

    // The cashier allowlist. Unchanged, and deliberately so: a cashier may count
    // a delivery in when the manager is not there (DESIGN-purchases.md 10), but
    // never sees or writes what it cost. Those units are absorbed at the
    // prevailing average -- a small, bounded inaccuracy, chosen over showing the
    // till the shop's margins.
    function stockMovementKeys() {
      return ['quantity', 'sold30', 'sold90', 'updatedAt', 'movementReason'];
    }

    function validStockMovementShape(allowedKeys) {
      let after = request.resource.data;
      return after.diff(resource.data).affectedKeys().hasOnly(allowedKeys)
        && stockCountInRange(after.quantity)
        && (!('sold30' in after) || countInRange(after.sold30))
        && (!('sold90' in after) || countInRange(after.sold90))
        && validMovementReason();
    }

    // ONE member read for role AND store access AND which allowlist applies,
    // the same collapsing memberSellsInStore() does and for the same reason: the
    // expression budget is real and this file has already been bitten by it. A
    // separate manager branch alongside the existing staff branch would have
    // meant a second get() on every cashier restock to decide a question the
    // first get() had already answered.
    // L-14. /products create was owner-only since 908eb03, which meant a
    // manager's FIRST transfer into a branch that did not yet stock the item
    // was refused -- confirmTransfer() creates the destination document, and
    // the manager could not. Decided by the owner on 2026-08-23: a manager may
    // create products in stores they are assigned to. Cashiers may not.
    //
    // ONE member read, for the same expression-budget reason as
    // memberMayUpdateProduct() below.
    function memberMayCreateProduct(ownerUid, storeId) {
      let path = memberDocPath(ownerUid);
      let m = exists(path) ? get(path).data : null;
      return m != null
        && m.status == "active"
        && m.role == "manager"
        && (("all" in m.storeIds) || (storeId in m.storeIds));
    }

    function memberMayUpdateProduct(ownerUid, storeId) {
      let path = memberDocPath(ownerUid);
      let m = exists(path) ? get(path).data : null;
      return m != null
        && m.status == "active"
        && m.role in ["manager", "cashier"]
        && (("all" in m.storeIds) || (storeId in m.storeIds))
        // One list again. Phase B briefly branched this on role so a manager
        // could write cost here; moving cost to /productCosts removed the
        // reason, and with it the trap DESIGN-purchases.md 9 describes -- there
        // is no longer a cost key that a restock could add to this write.
        && validStockMovementShape(stockMovementKeys());
    }

    // Per-item content validation used to live here as validSaleItem() applied
    // across 40 manually unrolled slots. It had to go: Firestore caps a single
    // rule evaluation at 1000 expressions, and that unroll blew the cap for any
    // STAFF sale of two or more line items. Staff pay for the member-document
    // get()s that decide their role and store access; an owner does not, because
    // isOwner() short-circuits first. So the owner could sell any basket while
    // every cashier hit permission-denied on their second line item -- the exact
    // shape of the outage this replaces, and invisible to owner-side testing.
    //
    // Measured, not guessed (tests/rules-budget-probe*.mjs): 40 slots died at 2
    // items; trimming the per-item checks reached 10; collapsing the duplicate
    // member get()s into memberSellsInStore() below still died at 5. Only
    // dropping per-item iteration makes the cost constant, and a 40-line basket
    // then passes comfortably.
    //
    // What remains is everything that is cheap AND load-bearing: the basket is a
    // list of 1..40, cashierUid is pinned to the caller, storeId must be one the
    // member is assigned to, and the totals/orderNumber/staffName shapes below.
    // What is given up is cosmetic: per-line name and brand lengths, and a
    // per-line qty > 0. Neither was a security boundary. Stock movement is
    // authorised separately and independently (quantity >= 0, field-limited),
    // so an item row cannot move stock on its own, and the file already
    // documents that rules cannot tie a decrement to the sale that caused it --
    // the sale record plus auditLogs, reconciled by the owner, is that control.
    function validSaleItems(items) {
      return items is list && items.size() > 0 && items.size() <= 40;
    }

    // One member read for role AND store, instead of isOwnerOrRole() and
    // memberCanAccessStore() each doing their own. Same decision, measurably
    // cheaper on the hottest write in the schema.
    //
    // Credit is refused here for a cashier whose owner has withdrawn it
    // (DESIGN-permissions.md). Safe on this path for one reason worth keeping
    // true: a credit sale is refused OFFLINE at the till, so no queued sale can
    // meet this clause at replay time and be discarded after the customer left.
    // If credit sales are ever queued offline, this clause must move to the UI.
    // Absent permissions mean ALLOWED -- every member document predating the
    // map keeps selling on credit exactly as it did.
    function memberSellsInStore(ownerUid, storeId, paymentMethod) {
      let path = memberDocPath(ownerUid);
      let m = exists(path) ? get(path).data : null;
      return m != null
        && m.status == "active"
        && m.role in ["manager", "cashier"]
        && (("all" in m.storeIds) || (storeId in m.storeIds))
        && (paymentMethod != "credit"
            || m.role == "manager"
            || m.get('permissions', {}).get('sellOnCredit', true) == true);
    }

    // Cashier permissions -- DESIGN-permissions.md.
    //
    // A map of booleans on the member document. An absent map, or an absent
    // key, means the DEFAULT, so nothing written before the map existed reads
    // any differently. The permissions only ever widen or narrow a CASHIER: a
    // manager already holds every one of them, and each helper below lets a
    // manager through on role rather than consulting the map.
    //
    // One member read per helper, for the expression-budget reason recorded on
    // memberSellsInStore() above.
    function memberCashierMay(ownerUid, storeId, key) {
      let path = memberDocPath(ownerUid);
      let m = exists(path) ? get(path).data : null;
      return m != null
        && m.status == "active"
        && m.role == "cashier"
        && (("all" in m.storeIds) || (storeId in m.storeIds))
        && m.get('permissions', {}).get(key, false) == true;
    }

    // For the audit log, whose branch has already established an active
    // cashier through memberRole().
    function memberPermissionOn(ownerUid, key) {
      return get(memberDocPath(ownerUid)).data.get('permissions', {}).get(key, false) == true;
    }

    // A customer balance may go UP on a credit sale -- the sale itself is where
    // credit is authorised, above -- but a DECREASE is a repayment, and a
    // cashier whose owner has withdrawn repayments may not make one. This
    // narrows L-10 for such a cashier; it does not close it for a cashier who
    // holds the permission, who can still zero a debt with no payment behind it.
    function memberMayMoveBalance(ownerUid, storeId) {
      let path = memberDocPath(ownerUid);
      let m = exists(path) ? get(path).data : null;
      return m != null
        && m.status == "active"
        && m.role in ["manager", "cashier"]
        && (("all" in m.storeIds) || (storeId in m.storeIds))
        && (m.role == "manager"
            || request.resource.data.balanceOwed >= resource.data.balanceOwed
            || m.get('permissions', {}).get('takeRepayments', true) == true);
    }

    function memberMayTakeRepayment(ownerUid) {
      let path = memberDocPath(ownerUid);
      let m = exists(path) ? get(path).data : null;
      return m != null
        && (m.role == "manager" || m.get('permissions', {}).get('takeRepayments', true) == true);
    }

    function validSale() {
      let d = request.resource.data;
      return validSaleItems(d.items)
        && totalInRange(d.total)
        && d.cashierUid == request.auth.uid
        && d.voided == false
        && d.storeId is string && d.storeId.size() > 0
        && d.staffId is string && d.staffId.size() > 0
        && d.staffName is string && d.staffName.size() > 0 && d.staffName.size() <= 80
        && d.orderNumber is string && d.orderNumber.matches('^[0-9]{1,10}$')
        && (!('subtotal' in d) || totalInRange(d.subtotal))
        // QA-113. Both were range-checked and neither was tied to the other, so
        // a sale could claim a 1,000,000 subtotal and a total of 100. Past this
        // point the discount is client-side only, which is precisely what the
        // override password exists to control.
        && (!('subtotal' in d) || d.total == d.subtotal - d.get('discountAmount', 0))
        && (!('discountType' in d) || d.discountType in ['none', 'percent', 'fixed'])
        && (!('discountValue' in d) || totalInRange(d.discountValue))
        && (!('discountAmount' in d) || totalInRange(d.discountAmount))
        // 'bank' added for spec 6, which lists Cash / Bank / Mobile Money /
        // Credit. 'card' stays: sales already recorded carry it, and dropping a
        // value from this set would make those sales unwritable on any later edit.
        && d.paymentMethod in ['cash', 'mobile', 'card', 'bank', 'credit']
        && (!('customerId' in d) || d.customerId == null || (d.customerId is string && d.customerId.size() > 0))
        && (!('amountPaid' in d) || d.amountPaid == null || totalInRange(d.amountPaid))
        && (!('balanceDue' in d) || d.balanceDue == null || totalInRange(d.balanceDue))
        // Filed in DESIGN §13 and deferred only because no emulator was
        // available to re-run the rules suites at the time. A sale rung up with
        // no connection is marked so a shelf count can be trusted or not, and
        // the field was type-free: madeOffline: "no" would have been accepted,
        // and any truthiness check downstream would then read a perfectly
        // ordinary sale as rung up blind. Every reader tests === true, which
        // closes it in practice; this closes it at the boundary.
        && (!('madeOffline' in d) || d.madeOffline is bool)
        // VAT (DESIGN-vat.md). All optional: a business that is not registered
        // writes none of them, and a sale from before it registered is outside
        // the scheme rather than taxed at zero.
        //
        // The last clause is the one worth the expressions. Rules cannot sum a
        // list, so they cannot check the tax against the items -- but net and
        // tax are scalars, and their sum is exactly the property the whole
        // feature is judged on. Enforcing it here means a client bug cannot
        // write a sale whose VAT return fails to reconcile to its own takings.
        && (!('vatRegistered' in d) || d.vatRegistered is bool)
        && (!('vrn' in d) || (d.vrn is string && d.vrn.size() <= 20))
        && (!('vatRate' in d) || (d.vatRate is number && d.vatRate >= 0 && d.vatRate <= 1))
        && (!('taxTotal' in d) || totalInRange(d.taxTotal))
        && (!('netTotal' in d) || totalInRange(d.netTotal))
        && (!('taxBreakdown' in d) || d.taxBreakdown is map)
        // QA-112. Written as `!a || !b || reconciles`, the guard short-circuits
        // to true whenever either side is missing -- so a sale carrying taxTotal
        // alone validated with any tax figure at all, on the one clause the
        // whole feature is judged on. They travel together or not at all.
        && (('taxTotal' in d) == ('netTotal' in d))
        && (!('taxTotal' in d) || d.netTotal + d.taxTotal == d.total);
    }

    function validShiftOpen() {
      let d = request.resource.data;
      return d.storeId is string && d.storeId.size() > 0
        && d.status == "open"
        && moneyInRange(d.openingFloat)
        && d.openedByUid == request.auth.uid
        && d.openedByName is string && d.openedByName.size() > 0 && d.openedByName.size() <= 80
        && (!('storeName' in d) || (d.storeName is string && d.storeName.size() <= 60));
    }

    // A close may only ever move an open shift to closed, and may not rewrite
    // how it opened. Without pinning the opening fields, a short drawer could be
    // reconciled away after the fact by raising the float it claims to have
    // started with.
    //
    // Pinning the float alone was not enough. The drawer is judged by
    //
    //     variance     = countedCash - expectedCash
    //     expectedCash = openingFloat + cashSales - cashRefunds + cashRepayments
    //
    // and closeShift() computes every one of those on the client. While the
    // rule only range-checked them, the person holding the cash supplied BOTH
    // sides of the subtraction meant to catch them: take 50,000, count the
    // drawer honestly, write expectedCash down to match, and the shift closes
    // balanced. Same attack the float pinning was written to stop, one field
    // along.
    //
    // What follows cannot prove cashSales -- rules cannot aggregate a shift's
    // sales, and no arrangement of them will. What it can do is force the five
    // numbers to agree with each other, which moves any lie out of `variance`,
    // where nothing contradicts it, and into `cashSales`, where the owner can
    // reconcile it against the sales collection. An unfalsifiable number
    // becomes a falsifiable one. The remaining gap is detective, not
    // preventive, and is recorded as such in KNOWN-LIMITATIONS.md.
    //
    // The arithmetic is written in the same order as app.js evaluates it, so
    // IEEE-754 rounding lands identically on both sides of the comparison.
    function shiftExpectedCashIsDerived() {
      let d = request.resource.data;
      return moneyInRange(d.cashSales)
        && moneyInRange(d.cashRefunds)
        && moneyInRange(d.cashRepayments)
        && d.expectedCash == resource.data.openingFloat + d.cashSales - d.cashRefunds + d.cashRepayments;
    }

    function validShiftClose() {
      let d = request.resource.data;
      return resource.data.status == "open"
        && d.status == "closed"
        && d.openingFloat == resource.data.openingFloat
        && d.openedByUid == resource.data.openedByUid
        && d.openedAt == resource.data.openedAt
        && d.storeId == resource.data.storeId
        && moneyInRange(d.countedCash)
        && moneyInRange(d.expectedCash)
        && signedMoneyInRange(d.variance)
        && shiftExpectedCashIsDerived()
        && d.variance == d.countedCash - d.expectedCash
        && d.closedByUid == request.auth.uid
        && d.closedByName is string && d.closedByName.size() > 0 && d.closedByName.size() <= 80
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    // Managers and cashiers may set which shift a till is currently on, and
    // nothing else about the store. Widening store writes outright would let a
    // cashier rename a branch or change its currency.
    function validShiftPointerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentShiftId']);
    }

    // The audit log is the detective control that F-4 falls back on when rules
    // cannot bind a stock decrement to a sale, so it is validated at least as
    // tightly as errorLog below it -- previously it was the loosest collection
    // in the schema, accepting any action string and any fields alongside it.
    //
    // Three separate problems, all reachable by an ordinary cashier's client:
    // a forged `action` ("SALE_VOIDED" from someone who cannot void) lays a
    // false trail through the one record the owner trusts; unbounded fields
    // and unbounded document width let the collection be filled with noise
    // until a real entry is unfindable; and every byte of it is billed to the
    // owner. `uid` was always honest -- everything the owner actually reads
    // was not.
    //
    // Actions are scoped to the role that can perform the underlying act. A
    // cashier cannot void a sale, so a cashier recording a void is either a
    // bug or misdirection; neither belongs in the ledger. The member get()
    // this costs is already paid by the create rule below, so scoping is
    // effectively free.
    function cashierAuditActions() {
      // SHIFT_CLOSED sits in the CASHIER list because a cashier closes the
      // till they opened -- /shifts create is already open to them. A cash
      // variance is precisely the event an audit trail exists for, and until
      // 2026-08-23 it was recorded only on the shift document itself.
      return ['SALE_COMPLETED', 'PRODUCT_RESTOCKED', 'PAYMENT_RECORDED', 'CREDIT_LIMIT_EXCEEDED',
              'SHIFT_CLOSED',
              // Credit extended with no ceiling check at all -- the customer was not
              // visible to this account, or had no limit set (QA-110/QA-120).
              // Cashier-writable because a cashier is who makes that sale.
              'CREDIT_LIMIT_UNCHECKED'];
    }
    function managerAuditActions() {
      return cashierAuditActions().concat(['SALE_VOIDED', 'RETURN_PROCESSED', 'CREDIT_LIMIT_CHANGED',
              // A manager is who spends on the shop's behalf, so a manager is
              // who records the spending -- and therefore who records that they
              // recorded it. Correcting and removing stay with the owner below.
              'EXPENSE_RECORDED',
              // Staff correct their OWN expense on the day they wrote it
              // (DESIGN-permissions.md 2), so the correction is theirs to log.
              'EXPENSE_UPDATED',
              // A manager receives deliveries, so a manager records that they
              // did. ONE entry per delivery, not one per line -- the per-product
              // trail is /stockMovements, which the stock ledger reconciles
              // against, and a sixth write a line would cost the transaction its
              // headroom under Firestore's 500-write cap.
              'DELIVERY_RECEIVED']);
    }
    // The ACCOUNT_* entries are the deletion-lifecycle evidence trail. Two of
    // them are written by the proxy's Admin SDK, which bypasses these rules
    // entirely, so they are listed for completeness rather than necessity --
    // but ACCOUNT_ACCESS_DURING_GRACE is written by the owner's own client
    // while the tenant is frozen, and omitting it broke exactly that (caught
    // by tests/rules-deletion.test.mjs, which is the point of that test).
    function ownerAuditActions() {
      return managerAuditActions().concat(
        [// Expenses and purchases stay deletable -- a mis-keyed delivery is a
         // human error and the shop must be able to remove it. That is exactly
         // why the removal has to leave a trace: every other money-touching
         // collection in this file refuses deletion outright, and a document
         // that can vanish silently is a note rather than a book.
         'EXPENSE_DELETED', 'PURCHASE_DELETED', 'DELIVERY_DELETED',
         'PRODUCT_CREATED', 'PRODUCT_EDITED', 'PRODUCT_DELETED', 'STORE_CURRENCY_CHANGED', 'STORE_ARCHIVED',
         'ACCOUNT_DELETION_REQUESTED', 'ACCOUNT_DELETION_CANCELLED', 'ACCOUNT_ACCESS_DURING_GRACE',
         'VAT_REGISTRATION_ENABLED', 'VAT_REGISTRATION_DISABLED',
         // Taking a backup is the only recovery path this system has on its
         // current plan -- there are no server-side backups and the version
         // retention window is one hour. Whether one was ever taken was
         // therefore the single most important thing about a tenant that
         // nothing recorded.
         'BACKUP_DOWNLOADED']);
    }

    // The union of every field the 12 auditLogs write sites in app.js emit.
    // Closed deliberately: adding an audit field is a schema decision that
    // should be made here as well as in the client, and
    // tests/rules-audit-log.test.mjs fails if the two disagree.
    function auditLogFields() {
      return ['action', 'uid', 'createdAt',
              'saleId', 'refundAmount', 'itemCount', 'total', 'saleTotal',
              'customerId', 'customerName', 'amount', 'method', 'storeId',
              'previousLimit', 'newLimit', 'limit', 'previousBalance', 'projectedTotal', 'authorised',
              'productId', 'name', 'sellingPrice', 'qtyAdded',
              'previousCode', 'newCode',
              'vrn', 'previouslyRegistered', 'storeCount', 'reason',
              'paymentMethod', 'discountType', 'discountAmount',
              // Expenses and purchases. `amount` above is reused for both an
              // expense amount and a purchase total; `qtyAdded` and `name` are
              // reused for the units and the product on a purchase.
              'category', 'expenseId', 'purchaseId',
              // What an expense said before a correction, beside `amount`.
              'previousAmount',
              // Deliveries reuse `amount` for the delivery's total cost and
              // `itemCount` for how many product lines it carried.
              'deliveryId',
              // Shift close. `variance` is the only signed figure in this list:
              // a short drawer is negative and moneyInRange() would refuse it,
              // which is why it is bounded separately below.
              'shiftId', 'expectedCash', 'countedCash', 'variance'];
    }

    function auditStringsBounded() {
      let d = request.resource.data;
      return (!('name' in d) || (d.name is string && d.name.size() <= 120))
        && (!('vrn' in d) || (d.vrn is string && d.vrn.size() <= 20))
        && (!('reason' in d) || (d.reason is string && d.reason.size() <= 40))
        && (!('customerName' in d) || (d.customerName is string && d.customerName.size() <= 120))
        && (!('method' in d) || (d.method is string && d.method.size() <= 40))
        && (!('paymentMethod' in d) || (d.paymentMethod is string && d.paymentMethod.size() <= 40))
        && (!('discountType' in d) || (d.discountType is string && d.discountType.size() <= 40))
        && (!('previousCode' in d) || (d.previousCode is string && d.previousCode.size() <= 8))
        && (!('newCode' in d) || (d.newCode is string && d.newCode.size() <= 8))
        && (!('saleId' in d) || (d.saleId is string && d.saleId.size() <= 120))
        && (!('customerId' in d) || (d.customerId is string && d.customerId.size() <= 120))
        && (!('productId' in d) || (d.productId is string && d.productId.size() <= 120))
        && (!('storeId' in d) || (d.storeId is string && d.storeId.size() <= 120))
        // Absent is fine; null is not. These read the same way customerId does
        // above, and for the same reason: a null here is a present key whose
        // value is not a string, so the whole write is refused -- which is how
        // a null customerId took every credit sale to a new customer down with
        // it. The client omits these fields rather than nulling them.
        && (!('category' in d) || (d.category is string && d.category.size() <= 40))
        && (!('expenseId' in d) || (d.expenseId is string && d.expenseId.size() <= 120))
        && (!('previousAmount' in d) || moneyInRange(d.previousAmount))
        && (!('purchaseId' in d) || (d.purchaseId is string && d.purchaseId.size() <= 120))
        && (!('deliveryId' in d) || (d.deliveryId is string && d.deliveryId.size() <= 120))
        && (!('shiftId' in d) || (d.shiftId is string && d.shiftId.size() <= 120))
        && (!('expectedCash' in d) || moneyInRange(d.expectedCash))
        && (!('countedCash' in d) || moneyInRange(d.countedCash))
        // Signed on purpose: negative is a short drawer, positive is over, and
        // refusing either would refuse the entry that matters most.
        && (!('variance' in d) || (d.variance is number
            && d.variance >= -1000000000 && d.variance <= 1000000000));
    }

    function validAuditLog(allowedActions) {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.action is string
        && d.action in allowedActions
        && d.keys().hasOnly(auditLogFields())
        && auditStringsBounded();
    }

    function validStore() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (!('archived' in d) || d.archived is bool)
        && (!('currencyCode' in d) || (d.currencyCode is string && d.currencyCode.matches('^[A-Z]{3}$')))
        // VAT registration is a BUSINESS fact, denormalised onto every store
        // for the same reason currencyCode is: the owner document is
        // owner-read-only, and a cashier's till has to know whether it is
        // charging VAT. The store doc is already loaded before the POS renders,
        // so this arrives with data the till already waits for rather than
        // adding a subscription that could fail on the sale path.
        // setVatRegistration() writes every store in one batch to stop the
        // copies drifting.
        && (!('vatRegistered' in d) || d.vatRegistered is bool)
        && (!('vrn' in d) || (d.vrn is string && d.vrn.size() <= 20))
        && (!('tin' in d) || (d.tin is string && d.tin.size() <= 20))
        && (!('vatEnabledAt' in d) || d.vatEnabledAt is timestamp);
    }

    function validStaff() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('archived' in d) || d.archived is bool);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        // A client may never self-assign a deletion state on creation either.
        && !('status' in request.resource.data)
        && !('deletedAt' in request.resource.data)
        && !('deletionScheduledFor' in request.resource.data);
      // The deletion-lifecycle fields are Admin-SDK-only. If a client could
      // write `status` it could freeze its own tenant, or -- far worse --
      // clear `pending_deletion` to escape the grace period and un-schedule a
      // purge. Unchanged-comparison rather than absence, so a merge write that
      // legitimately carries the existing value still succeeds.
      // role stays immutable for the reason given in ensureUserProfile().
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        && request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null)
        && request.resource.data.get('deletionScheduledFor', null) == resource.data.get('deletionScheduledFor', null);
      allow delete: if false;

      match /products/{productId} {
        // resource == null: see the note on the same branch under /sales.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validProduct() && (
             isOwner(userId)
          || memberMayCreateProduct(userId, request.resource.data.storeId));
        allow update: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validProduct() && productImmutableFieldsUnchanged())
          || memberMayUpdateProduct(userId, resource.data.storeId));
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      // Services / menu items (DESIGN-services.md). Sibling to products
      // because a service has no stock -- see validService() above.
      //
      // Read is scoped exactly like products: a cashier must see the menu to
      // sell from it, but only for a store they are assigned to. The
      // resource == null branch is the same one products carries, for the same
      // reason given under /sales.
      //
      // Write is owner-only, with NO staff branch at all. products has one
      // because selling has to decrement stock, so a cashier must be able to
      // touch that document mid-sale. Selling a service writes nothing back to
      // it -- there is no shelf to move -- so nothing on the sale path needs
      // this collection to be writable, and the narrower rule is the correct
      // one. Pricing the menu stays an owner decision.
      // A record of money leaving the business. Managers may write one --
      // DESIGN-purchases.md 10 -- because they are who spends on the shop's
      // behalf, but corrections belong to the owner: an expense is a book
      // entry, and letting the person who wrote it silently rewrite the amount
      // is the control this collection exists to provide.
      //
      // Cashiers are excluded in both directions. Expenses feed net profit, and
      // wages is a category.
      // The Purchase Book. Managers and owners write, because both restock;
      // a cashier is refused in both directions, because a cashier who knows the
      // buying price of every item knows the margin on every sale
      // (DESIGN-purchases.md 10). Corrections are the owner's, exactly as for
      // expenses -- and here it matters more, because a purchase has already
      // moved the product's weighted average by the time anyone edits it.
      // Readable by owner and manager only. This match block is the whole
      // reason cost is not a field on the product: /products is readable by
      // every cashier, and Firestore cannot withhold one field of a document.
      // Append-only, and readable by the same people as the current average.
      // No update and no delete: an edited history is not a history, and a
      // deleted one silently rewrites every period report that ever read it.
      // This is the collection an audit pack would rest on, so it is held to the
      // same rule as /auditLogs and /stockMovements rather than to the
      // deletable-by-decision rule /purchases and /expenses carry.
      match /productCostHistory/{recordId} {
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validProductCostHistory() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && memberCanAccessStore(userId, request.resource.data.storeId)));
        allow update, delete: if false;
      }

      match /productCosts/{productId} {
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validProductCost() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && memberCanAccessStore(userId, request.resource.data.storeId)));
        allow update: if tenantNotFrozen(userId) && validProductCost()
          && productCostImmutableFieldsUnchanged() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && memberCanAccessStore(userId, resource.data.storeId)));
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      match /purchases/{purchaseId} {
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validPurchaseCreate() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && memberCanAccessStore(userId, request.resource.data.storeId)));
        allow update: if isOwner(userId) && tenantNotFrozen(userId)
          && validPurchase() && purchaseImmutableFieldsUnchanged();
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      // The goods received notes -- DESIGN-landed-costs.md phase 2.
      //
      // Scoped exactly like /purchases, because it is the same disclosure: a
      // delivery header states what a shop paid for a shipment, and a cashier
      // who knows that knows the margin on everything in it. Managers write,
      // because managers receive deliveries; corrections are the owner's.
      //
      // DELETE, opened in phase 3 and not before. Phase 2 refused it outright
      // because /purchases pairs deletion with a PURCHASE_DELETED audit entry and
      // there was no DELIVERY_DELETED -- no client could write one, so permitting
      // the delete would have put an untraceable removal of a money document live
      // ahead of anything that could record it. deleteDelivery() in app.js now
      // writes that entry, and takes the delivery's purchase lines with it: a
      // header removed while its lines survive makes the Purchase Book
      // double-count the moment the delivery is re-recorded.
      // Owner only, like every other correction in this file.
      match /deliveries/{deliveryId} {
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validDeliveryCreate() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && memberCanAccessStore(userId, request.resource.data.storeId)));
        allow update: if isOwner(userId) && tenantNotFrozen(userId)
          && validDelivery() && deliveryImmutableFieldsUnchanged();
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      // A cashier's delivery, waiting for a manager or the owner --
      // DESIGN-permissions.md 4.
      //
      // Why a request and not a delivery: receiving stock moves the weighted
      // average cost, which means reading /productCosts inside the transaction,
      // and a cashier who can read that knows the margin on everything. So the
      // cashier states what arrived -- quantities, supplier, reference -- and
      // the stock and the cost move together when someone allowed to see cost
      // approves it.
      //
      // Never deleted. A request is cancelled, rejected or approved, and each is
      // a status on the same document.
      match /deliveryRequests/{requestId} {
        function validDeliveryRequest() {
          let d = request.resource.data;
          return d.keys().hasOnly(['storeId', 'requestedByUid', 'requestedByName', 'status',
                                   'supplierName', 'reference', 'note', 'invoiceTotal',
                                   'receivedAt', 'lines', 'createdAt', 'updatedAt',
                                   'decidedByUid', 'decidedAt', 'deliveryId', 'rejectReason'])
            && d.storeId is string && d.storeId.size() > 0 && d.storeId.size() <= 120
            && d.requestedByUid is string && d.requestedByUid.size() > 0
            && d.requestedByName is string && d.requestedByName.size() > 0 && d.requestedByName.size() <= 80
            && d.status in ['pending', 'approved', 'rejected', 'cancelled']
            && d.supplierName is string && d.supplierName.size() <= 60
            && (!('reference' in d) || (d.reference is string && d.reference.size() <= 60))
            && (!('note' in d) || (d.note is string && d.note.size() <= 200))
            && (!('invoiceTotal' in d) || totalInRange(d.invoiceTotal))
            && d.receivedAt is timestamp && d.receivedAt < request.time + duration.value(2, 'd')
            // The line cap is the delivery dialog's own, so an approved request
            // always fits the dialog it is opened in. Per-line content is not
            // iterated, for the expression-budget reason given at validSaleItems().
            && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 80
            && d.createdAt is timestamp;
        }

        function decisionOnlyChanged() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'decidedByUid', 'decidedAt', 'deliveryId', 'rejectReason', 'updatedAt']);
        }

        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)))
          || (resource.data.requestedByUid == request.auth.uid
              && memberCashierMay(userId, resource.data.storeId, 'receiveDeliveries'));

        allow create: if tenantNotFrozen(userId) && validDeliveryRequest()
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !('decidedByUid' in request.resource.data)
          && !('deliveryId' in request.resource.data)
          && memberCashierMay(userId, request.resource.data.storeId, 'receiveDeliveries');

        allow update: if tenantNotFrozen(userId) && validDeliveryRequest()
          // Only a pending request moves. A decided one is history.
          && resource.data.status == 'pending'
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.requestedByUid == resource.data.requestedByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            // The person who asked edits or cancels their own.
            (request.resource.data.status in ['pending', 'cancelled']
              && resource.data.requestedByUid == request.auth.uid
              && !('decidedByUid' in request.resource.data)
              && !('deliveryId' in request.resource.data)
              && memberCashierMay(userId, resource.data.storeId, 'receiveDeliveries'))
            // Someone allowed to see cost decides.
            || ((isOwner(userId)
                 || (isOwnerOrRole(userId, ["manager"]) && memberCanAccessStore(userId, resource.data.storeId)))
              && decisionOnlyChanged()
              && request.resource.data.decidedByUid == request.auth.uid
              && request.resource.data.decidedAt == request.time
              && (
                // Approval is only true together with the delivery it produced:
                // the delivery must exist after this write and not before it, so
                // a request cannot be marked approved on its own, nor pointed at
                // a delivery that was recorded some other day.
                (request.resource.data.status == 'approved'
                  && request.resource.data.deliveryId is string
                  && request.resource.data.deliveryId.size() > 0
                  && request.resource.data.deliveryId.size() <= 120
                  && existsAfter(/databases/$(database)/documents/users/$(userId)/deliveries/$(request.resource.data.deliveryId))
                  && !exists(/databases/$(database)/documents/users/$(userId)/deliveries/$(request.resource.data.deliveryId)))
                || (request.resource.data.status == 'rejected'
                  && request.resource.data.rejectReason is string
                  && request.resource.data.rejectReason.size() > 0
                  && request.resource.data.rejectReason.size() <= 200)))
          );

        allow delete: if false;
      }

      // DESIGN-permissions.md 2. A cashier holding recordExpenses records,
      // reads and corrects ONLY their own entries -- never the book, never
      // another person's. The list query in app.js filters on recordedByUid for
      // exactly this reason; without the filter the rule cannot be proven and
      // the whole query is refused.
      //
      // Correcting is bounded for staff, managers included: their OWN record,
      // within 24 hours of writing it. An expense that can be rewritten at any
      // later time is not evidence of anything, and inflating one paid "from the
      // till" is how missing cash is usually covered. The screen stops at local
      // midnight; the rules cannot know the shop's time zone, so this is the
      // looser ceiling behind it. Every correction is audited by saveExpense().
      // Deletion stays the owner's alone.
      match /expenses/{expenseId} {
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)))
          || (resource.data.recordedByUid == request.auth.uid
              && memberCashierMay(userId, resource.data.storeId, 'recordExpenses'));
        allow create: if tenantNotFrozen(userId) && validExpenseCreate() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && memberCanAccessStore(userId, request.resource.data.storeId))
          || (memberCashierMay(userId, request.resource.data.storeId, 'recordExpenses')
              && staffExpenseDateInWindow()));
        allow update: if tenantNotFrozen(userId) && validExpense() && expenseImmutableFieldsUnchanged() && (
             isOwner(userId)
          || (resource.data.recordedByUid == request.auth.uid
              && request.time < resource.data.createdAt + duration.value(1, 'd')
              && staffExpenseDateInWindow()
              && ((isOwnerOrRole(userId, ["manager"]) && memberCanAccessStore(userId, resource.data.storeId))
                  || memberCashierMay(userId, resource.data.storeId, 'recordExpenses'))));
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      match /services/{serviceId} {
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validService();
        allow update: if isOwner(userId) && tenantNotFrozen(userId)
          && validService() && serviceImmutableFieldsUnchanged();
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      match /stores/{storeId} {
        // storeId here comes from the document path itself, not
        // resource.data -- Firestore can prove this rule per-document
        // using each doc's own ID, so no `where` clause is required for
        // this collection's list queries (unlike products/sales/etc.,
        // whose storeId lives in the document body -- see the query-side
        // filtering added around resolveQueryStoreIds() in app.js).
        allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, storeId));
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validStore();
        allow update: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validStore())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, storeId) && validShiftPointerUpdate()));
        allow delete: if false;
      }

      match /staff/{staffId} {
        // Read opened to manager/cashier (Phase 3): staff need this list to
        // select their own name in POS. Write stays owner-only -- adding or
        // removing a cashier-name entry is still an owner action.
        // isOwnerOrRole() short-circuits on isOwner(), so no separate owner
        // branch is needed here either.
        allow read: if isOwnerOrRole(userId, ["manager", "cashier"]);
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validStaff();
        allow update: if isOwner(userId) && tenantNotFrozen(userId) && validStaff();
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      // RBAC (Phase 2): members/{staffUid} docs are the source of truth for
      // role/store access (see memberDocPath() etc. above). Only the owner
      // may write these directly. A staff member may read their OWN doc
      // (needed so the client can show them their own role/store scope in
      // the UI), but never another member's doc, and never write to any
      // member doc themselves -- role/store escalation must only ever
      // happen through the proxy's accept-invite endpoint (Admin SDK),
      // never via a direct client write, even by the staff member it
      // concerns.
      match /members/{staffUid} {
        allow read: if isOwner(userId) || (signedIn() && request.auth.uid == staffUid);
        allow write: if isOwner(userId) && tenantNotFrozen(userId);
      }

      match /sales/{saleId} {
        function validVoidUpdate() {
          let before = resource.data;
          let after = request.resource.data;
          return before.voided == false
            && after.voided == true
            && after.voidedAt is timestamp
            && after.items == before.items
            && after.total == before.total
            && after.paymentMethod == before.paymentMethod
            && after.cashTendered == before.cashTendered
            && after.changeDue == before.changeDue
            && after.branchId == before.branchId
            && after.cashierUid == before.cashierUid
            && after.createdAt == before.createdAt
            && (!('storeId' in before) || after.storeId == before.storeId)
            && (!('staffId' in before) || after.staffId == before.staffId)
            && (!('orderNumber' in before) || after.orderNumber == before.orderNumber)
            // QA-105b. A void restores the WHOLE sale, so voiding one that has
            // already been refunded refunds it a second time by another route.
            // The client nets prior returns off the void; the rules did not look
            // at refundedAmount at all. The second clause stops the obvious way
            // around the first -- clearing the refund record on the way through.
            && before.get('refundedAmount', 0) == 0
            && after.get('refundedAmount', 0) == 0;
        }

        function validReturnUpdate() {
          let before = resource.data;
          let after = request.resource.data;
          return before.voided == false
            && after.items == before.items
            && after.total == before.total
            && after.paymentMethod == before.paymentMethod
            && after.cashTendered == before.cashTendered
            && after.changeDue == before.changeDue
            && after.voided == before.voided
            && (!('branchId' in before) || after.branchId == before.branchId)
            && (!('storeId' in before) || after.storeId == before.storeId)
            && after.cashierUid == before.cashierUid
            && after.createdAt == before.createdAt
            && (!('staffId' in before) || after.staffId == before.staffId)
            && (!('orderNumber' in before) || after.orderNumber == before.orderNumber)
            && after.returns is list && after.returns.size() <= 20
            && after.refundedAmount is number && after.refundedAmount >= 0 && after.refundedAmount <= after.total
            // QA-105a. Bounded is not the same as monotonic. Refund the full
            // total, write refundedAmount: 0 with an empty returns array, and
            // refund it again -- indefinitely. The client caps by what has
            // already been returned, but the client is not the boundary, and an
            // insider with a manager account and a REST client is exactly who
            // this collection is guarded against. Proven exploitable against the
            // emulator before this line existed.
            && after.refundedAmount >= before.get('refundedAmount', 0)
            && after.returns.size() >= before.get('returns', []).size();
        }

        // A get() on a document that does not exist yields resource == null, and
        // reading a field off it makes the whole condition false rather than
        // erroring loudly. Completing a sale reads its own target id first, so a
        // retry resolves to the same path and cannot record the sale twice --
        // and on the normal path that read lands on a document that does not
        // exist yet. Without this branch every cashier and manager sale died at
        // the till with permission-denied; the owner never saw it because
        // isOwner short-circuits first. What a staff member can learn from the
        // null case is whether an id exists, never any content: an existing
        // document is still gated on their store access.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validSale()
          && (isOwner(userId) || memberSellsInStore(userId, request.resource.data.storeId, request.resource.data.paymentMethod));
        // Managers may void a full sale or process an itemized return, but
        // only for a store assigned to them -- owner reasoning revisited:
        // the owner isn't always on-site, and a manager already holds the
        // same trust level for returns. A void still has no itemized trail
        // (unlike a return, which is capped at the sale total and logged
        // per item), so this remains the single highest-trust write in the
        // schema; it's opened to managers only, never cashiers.
        allow update: if tenantNotFrozen(userId) && ((isOwner(userId) && (validVoidUpdate() || validReturnUpdate()))
          || (isOwnerOrRole(userId, ["manager"])
            && memberCanAccessStore(userId, resource.data.storeId)
            && (validVoidUpdate() || validReturnUpdate()))
          // A cashier the owner trusts with returns (DESIGN-permissions.md).
          // Returns only -- a void has no itemised trail and stays manager-only.
          // validReturnUpdate() is the same capped, monotonic check a manager
          // meets, so the permission widens WHO, never HOW MUCH.
          || (memberCashierMay(userId, resource.data.storeId, 'processReturns')
            && validReturnUpdate()));
        allow delete: if false;
      }

     match /customers/{customerId} {
        function validCustomer() {
          let d = request.resource.data;
          // QA-126. Every other name in this schema requires size() > 0; this one
          // did not, so a customer could be created with no name at all and then
          // appear in the receivables report as a blank row nobody can chase.
          return d.name is string && d.name.size() > 0 && d.name.size() <= 80
            && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
            && d.balanceOwed is number && d.balanceOwed >= 0
            && d.storeId is string && d.storeId.size() > 0
            && (!('oldestUnpaidAt' in d) || d.oldestUnpaidAt == null || d.oldestUnpaidAt is timestamp)
            && (!('creditLimit' in d) || d.creditLimit == null || (d.creditLimit is number && d.creditLimit >= 0));
        }
        // Cashier-safe: a credit sale (or recording a payment) only ever
        // touches balanceOwed/oldestUnpaidAt -- diff-checked so a cashier
        // write can't sneak in a creditLimit or name change alongside it.
        function validCustomerBalanceUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceOwed', 'oldestUnpaidAt', 'updatedAt'])
            && request.resource.data.balanceOwed is number && request.resource.data.balanceOwed >= 0;
        }
        // Credit limit is a manager/owner judgment call, not a cashier one.
        function validCustomerLimitUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditLimit']);
        }
        // resource == null: see the note on the same branch under /sales.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validCustomer())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, request.resource.data.storeId) && validCustomer()));
        allow update: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validCustomer())
          || (memberMayMoveBalance(userId, resource.data.storeId) && validCustomerBalanceUpdate())
          || (isOwnerOrRole(userId, ["manager"]) && memberCanAccessStore(userId, resource.data.storeId) && validCustomerLimitUpdate()));
        allow delete: if false;

        match /payments/{paymentId} {
          function validPayment() {
            let d = request.resource.data;
            return d.amount is number && d.amount > 0 && d.amount <= 1000000000000
              && (!('note' in d) || (d.note is string && d.note.size() <= 200));
          }
          allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, get(/databases/$(database)/documents/users/$(userId)/customers/$(customerId)).data.storeId));
          allow create: if tenantNotFrozen(userId) && (
               (isOwner(userId) && validPayment())
            || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberMayTakeRepayment(userId) && memberCanAccessStore(userId, get(/databases/$(database)/documents/users/$(userId)/customers/$(customerId)).data.storeId) && validPayment()));
          allow update, delete: if false;
        }
      }

      // Suppliers. DESIGN-suppliers-purchases.md 4.
      //
      // Until now a supplier was a free-text string retyped onto every purchase,
      // so "Twiga Cement", "Twiga cement" and "TWIGA" were three suppliers to
      // any report that grouped by them, and there was nowhere to record a
      // phone number, a TIN, or what is owed.
      //
      // Purchasing is not a till function, so writes are owner and manager only
      // -- narrower than /customers, which a cashier must be able to touch
      // mid-sale to record credit. Reads are wider than writes because the
      // product list denormalises a supplier name and a denied read would break
      // rendering for a cashier who is only selling.
      match /suppliers/{supplierId} {
        function validSupplier() {
          let d = request.resource.data;
          return d.name is string && d.name.size() > 0 && d.name.size() <= 80
            && d.storeId is string && d.storeId.size() > 0
            && d.openingBalance is number && d.openingBalance >= 0 && d.openingBalance <= 1000000000000
            && d.balanceOwed is number && d.balanceOwed >= 0 && d.balanceOwed <= 1000000000000
            && d.active is bool
            && (!('phone' in d) || (d.phone is string && d.phone.size() <= 20))
            && (!('email' in d) || (d.email is string && d.email.size() <= 120))
            && (!('address' in d) || (d.address is string && d.address.size() <= 200))
            && (!('tin' in d) || (d.tin is string && d.tin.size() <= 40))
            && (!('note' in d) || (d.note is string && d.note.size() <= 200));
        }
        // resource == null: see the note on the same branch under /sales.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validSupplier() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"]) && memberCanAccessStore(userId, request.resource.data.storeId)));
        allow update: if tenantNotFrozen(userId) && validSupplier() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"]) && memberCanAccessStore(userId, resource.data.storeId)));
        // Deactivated, never deleted: a supplier is referenced by every purchase
        // ever made from them, and deleting one would orphan that history.
        allow delete: if false;

        // What is owed, and what has been paid off it. Spec 5.4.
        //
        // The balance is STORED rather than computed from the delivery history,
        // and that is forced rather than chosen: subscribeToDeliveries() is
        // bounded by ACCOUNTS_HISTORY_LIMIT (L-13), so a client adding up the
        // deliveries it happens to hold would silently UNDERSTATE what is owed
        // to a supplier with more history than the window. An understated debt
        // is the direction that loses money.
        //
        // Same shape as the customer credit book, which has the same problem in
        // the other direction.
        match /payments/{paymentId} {
          function validSupplierPayment() {
            let d = request.resource.data;
            return d.amount is number && d.amount > 0 && d.amount <= 1000000000
              && d.method in ['cash', 'bank', 'mobile']
              && (!('note' in d) || (d.note is string && d.note.size() <= 200))
              && (!('reference' in d) || (d.reference is string && d.reference.size() <= 60));
          }
          allow read: if isOwner(userId)
            || (isOwnerOrRole(userId, ["manager"])
                && memberCanAccessStore(userId, get(/databases/$(database)/documents/users/$(userId)/suppliers/$(supplierId)).data.storeId));
          allow create: if tenantNotFrozen(userId) && validSupplierPayment() && (
               isOwner(userId)
            || (isOwnerOrRole(userId, ["manager"])
                && memberCanAccessStore(userId, get(/databases/$(database)/documents/users/$(userId)/suppliers/$(supplierId)).data.storeId)));
          // A payment is a book entry. Correcting one is a new entry, not a
          // rewrite -- the same rule /customers/payments and /expenses carry.
          allow update, delete: if false;
        }
      }

      // Goods sent back to a supplier. Spec 5.5.
      //
      // A separate record rather than an edit to the purchase: the purchase is
      // what was actually bought and paid, and rewriting it would destroy the
      // history the Purchase Book exists to keep. The return carries its own
      // quantity and value, and reports net one against the other.
      //
      // Owner and manager only, matching /suppliers -- sending stock back to a
      // supplier is a buying decision, not a till one.
      match /purchaseReturns/{returnId} {
        function validPurchaseReturn() {
          let d = request.resource.data;
          return d.storeId is string && d.storeId.size() > 0
            && d.productId is string && d.productId.size() > 0
            && d.productName is string && d.productName.size() > 0 && d.productName.size() <= 120
            && d.quantity is number && d.quantity > 0 && d.quantity <= 1000000
            && d.amount is number && d.amount >= 0 && d.amount <= 1000000000
            && (!('purchaseId' in d) || (d.purchaseId is string && d.purchaseId.size() <= 120))
            && (!('supplierId' in d) || (d.supplierId is string && d.supplierId.size() <= 120))
            && (!('supplierName' in d) || (d.supplierName is string && d.supplierName.size() <= 120))
            && (!('reason' in d) || (d.reason is string && d.reason.size() <= 200));
        }
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && validPurchaseReturn() && (
             isOwner(userId)
          || (isOwnerOrRole(userId, ["manager"]) && memberCanAccessStore(userId, request.resource.data.storeId)));
        // A book entry: corrected by another entry, never rewritten.
        allow update, delete: if false;
      }

      // A shift is one till, one person, one stretch of time: opened with a
      // float, closed with a physical count, and carrying the difference
      // between what the system expected and what was actually there.
      //
      // Only one shift may be open per store at a time. Rules cannot express
      // that on their own, so the store document carries a currentShiftId
      // pointer and both open and close run as transactions against it --
      // see validShiftPointerUpdate above.
      match /shifts/{shiftId} {
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validShiftOpen())
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && memberCanAccessStore(userId, request.resource.data.storeId)
              && validShiftOpen()));
        // A cashier closes the drawer they opened, and no one else's. One shift
        // is open per till rather than per person, so without this any cashier
        // rostered to the store could count and close a colleague's drawer --
        // both uids were recorded, but a shortfall then belonged to two people
        // at once, and the closing cash figures come from the client (L-1 in
        // KNOWN-LIMITATIONS.md), so that is the wrong pair of hands to leave it
        // in.
        //
        // Managers and the owner may close any shift at a store they can reach.
        // That is the escape hatch, not a loophole: a cashier who goes home
        // without closing would otherwise strand the till, because
        // currentShiftId stays set and no new shift can open behind it.
        allow update: if tenantNotFrozen(userId) && validShiftClose() && (
             isOwner(userId)
          || (memberRole(userId) == "manager"
              && memberCanAccessStore(userId, resource.data.storeId))
          || (memberRole(userId) == "cashier"
              && memberCanAccessStore(userId, resource.data.storeId)
              && resource.data.openedByUid == request.auth.uid));
        // A reconciliation record that can be removed is not a record.
        allow delete: if false;
      }

      // The stock ledger (L-2). One append-only document per movement of
      // stock, written in the same transaction as the movement itself.
      //
      // F-4 records that rules cannot bind a stock decrement to a sale: they
      // authorise one write at a time and cannot see the sale document created
      // alongside. That stays true here -- a client can still decline to write
      // the ledger entry. What changes is that declining becomes VISIBLE.
      //
      // The mechanism is quantityBefore/quantityAfter. Each entry records the
      // shelf on both sides of the movement, and the rule below requires them
      // to agree with the delta. So the ledger is a chain: replayed forward, the
      // last quantityAfter for a product must equal that product's current
      // quantity. Stock that moved without an entry leaves a gap between the
      // two, and the gap is exactly the amount that went missing. That is a
      // detective control, which is all F-4 ever claimed was reachable -- but
      // it is one an owner can read, rather than one that requires a physical
      // stocktake to notice.
      //
      // Append-only and owner-read, like auditLogs: staff write what they did
      // and cannot read the collection back or tidy it afterwards. Bounded so a
      // loop cannot write unbounded documents.
      match /stockMovements/{movementId} {
        // An entry made offline cannot honestly carry the chain (L-9, phase A).
        //
        // quantityBefore is read from a cache that may be stale by the time a
        // queued write lands. Recording it anyway would produce a chain that
        // does not match the shelf, and reconcileProductStock() would report
        // that difference as unaccounted stock -- the anti-theft control
        // accusing a cashier for every sale made during an outage.
        //
        // So an offline entry states LESS rather than something false: the
        // delta, which is always known, and nothing about the shelf either side
        // of it. The reconciliation treats such products as unknown until their
        // next online movement re-anchors the chain.
        //
        // The two shapes are mutually exclusive and both are enforced. An entry
        // may not claim to be offline while carrying a chain (that would be a
        // guess wearing the authority of a measurement), and it may not omit the
        // chain without saying why.
        function movementIsOffline() {
          return 'offline' in request.resource.data && request.resource.data.offline == true;
        }

        function validMovementShape() {
          let d = request.resource.data;
          return movementIsOffline()
            ? (!('quantityBefore' in d) && !('quantityAfter' in d))
            : (stockCountInRange(d.quantityBefore)
               && stockCountInRange(d.quantityAfter)
               // The chain link. Without this an entry could claim any
               // resulting shelf and the replay would agree with whatever it
               // was told.
               && d.quantityAfter == d.quantityBefore + d.delta);
        }

        function validStockMovement() {
          let d = request.resource.data;
          return d.productId is string && d.productId.size() > 0 && d.productId.size() <= 120
            && d.storeId is string && d.storeId.size() > 0 && d.storeId.size() <= 120
            && d.reason in ['sale', 'restock', 'return', 'void', 'transfer-in', 'transfer-out', 'adjustment', 'supplier-return']
            && d.delta is number && d.delta >= -1000000 && d.delta <= 1000000
            && (!('offline' in d) || d.offline is bool)
            && validMovementShape()
            && d.uid == request.auth.uid
            && (!('productName' in d) || (d.productName is string && d.productName.size() <= 120))
            && (!('saleId' in d) || (d.saleId is string && d.saleId.size() <= 120))
            && (!('transferId' in d) || (d.transferId is string && d.transferId.size() <= 120))
            && (!('staffName' in d) || (d.staffName is string && d.staffName.size() <= 80))
            // WHY the shelf was corrected. Spec 4.4 asks for the reason to be
            // recorded, and a closed set rather than free text because this is
            // the field an owner filters on when asking where stock went --
            // "Damaged" and "damaged" and "broke it" cannot be counted together.
            //
            // Only meaningful alongside reason == 'adjustment', but not tied to
            // it here: rules validate a write in isolation, and coupling the two
            // is the same trap documented on validMovementReason() above.
            && (!('adjustmentReason' in d) || d.adjustmentReason in
                ['count', 'damaged', 'expired', 'lost', 'theft', 'correction', 'opening', 'other'])
            && (!('note' in d) || (d.note is string && d.note.size() <= 200));
        }
        allow read: if isOwner(userId);
        allow create: if tenantNotFrozen(userId)
          && isOwnerOrRole(userId, ["manager", "cashier"])
          && validStockMovement()
          && (isOwner(userId) || memberCanAccessStore(userId, request.resource.data.storeId));
        // A ledger that can be edited or removed is not a ledger.
        allow update, delete: if false;
      }

      match /transfers/{transferId} {
        function validTransfer() {
          let d = request.resource.data;
          return d.productId is string && d.productId.size() > 0
            && d.productName is string && d.productName.size() <= 120
            && countInRange(d.quantity) && d.quantity > 0
            && d.sourceStoreId is string && d.sourceStoreId.size() > 0
            && d.destinationStoreId is string && d.destinationStoreId.size() > 0
            // QA-127. A transfer to itself writes two ledger entries that cancel,
            // so the shelf is unchanged and the chain gains two entries describing
            // a movement that never happened.
            && d.sourceStoreId != d.destinationStoreId
            && d.staffName is string && d.staffName.size() > 0 && d.staffName.size() <= 80
            && (!('destinationProductId' in d) || (d.destinationProductId is string && d.destinationProductId.size() > 0))
            && (!('sourceStoreName' in d) || (d.sourceStoreName is string && d.sourceStoreName.size() <= 60))
            && (!('destinationStoreName' in d) || (d.destinationStoreName is string && d.destinationStoreName.size() <= 60))
            && d.performedByUid == request.auth.uid;
        }
        allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && (memberCanAccessStore(userId, resource.data.sourceStoreId) || memberCanAccessStore(userId, resource.data.destinationStoreId)));
        allow create: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validTransfer())
          || (isOwnerOrRole(userId, ["manager"]) && validTransfer()
              && memberCanAccessStore(userId, request.resource.data.sourceStoreId)
              && memberCanAccessStore(userId, request.resource.data.destinationStoreId)));
        allow update, delete: if false;
      }

      // Client faults, so a shop breaking is something the owner can see rather
      // than something they have to phone about. 73 console.warn calls existed
      // before this and every one of them landed in a browser console on a
      // phone nobody will ever open.
      //
      // Append-only and owner-read: staff write what broke in front of them but
      // cannot read the collection back or tidy it afterwards. Bounded fields
      // so a loop cannot write unbounded documents, and no field here is meant
      // to carry customer data -- the client strips what looks like a phone
      // number or an email before sending.
      match /errorLog/{entryId} {
        function validErrorEntry() {
          let d = request.resource.data;
          return d.message is string && d.message.size() > 0 && d.message.size() <= 300
            && d.uid == request.auth.uid
            && (!('where' in d) || (d.where is string && d.where.size() <= 200))
            && (!('kind' in d) || d.kind in ['error', 'rejection'])
            && (!('storeId' in d) || d.storeId == null || (d.storeId is string && d.storeId.size() <= 64))
            && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 40));
        }
        allow read: if isOwner(userId);
        // isOwnerOrRole() already short-circuits on isOwner(), so the owner
        // needs no separate branch here -- and spelling one out suggested a
        // distinction that does not exist.
        allow create: if tenantNotFrozen(userId)
          && isOwnerOrRole(userId, ["manager", "cashier"])
          && validErrorEntry();
        // A fault report that can be edited or removed is not a report.
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        // Deliberately NOT gated on tenantNotFrozen(). A frozen tenant must
        // still be able to record what happened to it -- the deletion request
        // itself, the restore, and any access attempt during the grace period
        // are exactly the events an erasure audit needs. Freezing the audit
        // log would destroy the evidence trail for the deletion it is meant
        // to document. Entries remain append-only regardless.
        allow read: if isOwner(userId);
        // One branch per role rather than a single role list, because the set
        // of actions each may record differs -- see validAuditLog above.
        allow create: if (isOwner(userId) && validAuditLog(ownerAuditActions()))
          || (memberRole(userId) == "manager" && validAuditLog(managerAuditActions()))
          || (memberRole(userId) == "cashier" && (validAuditLog(cashierAuditActions())
               // Actions a cashier may log only while they hold the permission
               // that lets them perform it -- the false-trail rule above,
               // applied per permission rather than per role.
               || (validAuditLog(['EXPENSE_RECORDED', 'EXPENSE_UPDATED']) && memberPermissionOn(userId, 'recordExpenses'))
               || (validAuditLog(['RETURN_PROCESSED']) && memberPermissionOn(userId, 'processReturns'))));
        allow update, delete: if false;
      }

      match /monthlyReports/{reportId} {
        function validMonthlyReport() {
          let d = request.resource.data;
          return d.storeId is string && d.storeId.size() > 0
            && d.periodLabel is string && d.periodLabel.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && d.periodStart is timestamp && d.periodEnd is timestamp
            && d.generatedBy == request.auth.uid
            && d.metrics is map
            && d.aiSummary is string && d.aiSummary.size() <= 6000;
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validMonthlyReport();
        allow update: if isOwner(userId) && tenantNotFrozen(userId) && validMonthlyReport();
        allow delete: if false;
      }

      // Per-business override-password hash (Phase 9). No client may read or
      // write this directly, not even the doc's own owner -- if it were
      // readable, the owner's own browser could fetch the hash and brute-
      // force it offline, defeating server-side verification entirely. Only
      // the proxy's Firebase Admin SDK (which bypasses these rules) may
      // touch it, via POST /api/settings/override-password and
      // POST /api/ai/override-verify in proxy/server.js.
      match /private/security {
        allow read, write: if false;
      }
    }
  }
}
