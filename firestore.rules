rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // RBAC (Phase 1): members/{staffUid} docs live under the owner's own
    // users/{ownerUid} tree -- no data restructuring needed. A get() lookup
    // (not a custom claim) is the source of truth for role/store access so
    // that disabling a staff member takes effect on their very next request,
    // not after their ID token happens to expire.
    function memberDocPath(ownerUid) {
      return /databases/$(database)/documents/users/$(ownerUid)/members/$(request.auth.uid);
    }

    function isActiveMember(ownerUid) {
      return signedIn()
        && exists(memberDocPath(ownerUid))
        && get(memberDocPath(ownerUid)).data.status == "active";
    }

    function memberRole(ownerUid) {
      return isActiveMember(ownerUid) ? get(memberDocPath(ownerUid)).data.role : null;
    }

    function memberStoreIds(ownerUid) {
      return isActiveMember(ownerUid) ? get(memberDocPath(ownerUid)).data.storeIds : [];
    }

    // "all" is an explicit opt-in for a member who should see every branch
    // (e.g. a roaming manager) -- absent that, a member only reaches the
    // specific storeIds assigned to them.
    function memberCanAccessStore(ownerUid, storeId) {
      let ids = memberStoreIds(ownerUid);
      return ("all" in ids) || (storeId in ids);
    }

    function isOwnerOrRole(ownerUid, roles) {
      return isOwner(ownerUid) || memberRole(ownerUid) in roles;
    }

    // Deletion lifecycle, phase 1 (see SECURITY-AUDIT.md F-1 and
    // DATA-DELETION.md). Once an owner requests deletion their tenant is
    // frozen read-only for a 30-day grace period: existing data stays
    // readable so they can review it and self-serve a restore, but nothing
    // new may be written. Only the proxy's Admin SDK can set or clear this
    // status -- no client can, because users/{userId} update forbids
    // changing it (see the users match block).
    //
    // A missing users/{userId} doc is treated as active: a brand-new signup
    // writes its first store before its profile document exists, and an
    // absent profile must not read as "frozen".
    //
    // Applied to WRITES only, deliberately. Every get() inside a rule is a
    // billed read, and reads outnumber writes heavily in a POS. Immediate
    // read lockout for STAFF is handled instead by the proxy disabling their
    // Firebase Auth accounts and revoking refresh tokens at request time,
    // which is both free and faster-acting than any rule.
    function tenantNotFrozen(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId))
        || get(/databases/$(database)/documents/users/$(userId)).data.get('status', 'active') != 'pending_deletion';
    }

    function validProduct() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.category is string && d.category.size() <= 60
        && d.brand is string && d.brand.size() <= 60
        && d.supplier is string && d.supplier.size() <= 60
        && d.quantity is number && d.quantity >= 0
        && d.storeId is string && d.storeId.size() > 0
        && (!('barcode' in d) || (d.barcode is string && d.barcode.size() <= 64))
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && (!('warehouse' in d) || (d.warehouse is string && d.warehouse.size() <= 60))
        && (!('shelf' in d) || (d.shelf is string && d.shelf.size() <= 60))
        && (!('sku' in d) || (d.sku is string && d.sku.size() <= 40))
        && (!('costPrice' in d) || (d.costPrice is number && d.costPrice >= 0))
        && (!('sellingPrice' in d) || (d.sellingPrice is number && d.sellingPrice >= 0))
        && (!('reorderLevel' in d) || (d.reorderLevel is number && d.reorderLevel >= 0))
        && (!('expiryDate' in d) || (d.expiryDate is string && d.expiryDate.size() <= 10));
    }

    function productImmutableFieldsUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('storeId' in resource.data) || request.resource.data.storeId == resource.data.storeId);
    }

    // Cashier-safe stock movement: staff may move stock levels but touch
    // nothing else on the product doc -- name/price/category/etc. stay
    // owner-only edits. diff().affectedKeys() proves exactly which fields
    // changed, so this can't be widened into a general product edit.
    //
    // Covers all four client stock paths, which each write exactly this field
    // set: a sale decrements quantity and raises sold30/sold90; a restock
    // raises quantity alone; a return or void does the reverse of a sale.
    //
    // Deliberately NOT increase-only. An earlier version required
    // quantity >= resource.data.quantity, which blocked the sale path
    // outright -- the stock decrement was denied inside the same transaction
    // that created the sale, so the transaction rolled back and no cashier or
    // manager could complete a sale at all.
    //
    // Note the real limit here: rules authorize each write independently, so
    // this cannot verify that a matching sale document was created in the
    // same transaction. A cashier could therefore write down stock without a
    // corresponding sale. The compensating controls are the sale record and
    // the auditLogs entry (both required and both owner-readable), plus
    // physical stock reconciliation -- not this rule.
    // F-4. movementReason records WHY stock moved, so the owner's audit trail
    // distinguishes a sale from a restock from a return instead of showing a
    // bare number change. Only the enum is validated here.
    //
    // Direction-coupling (rejecting a "restock" that decreases stock) was
    // implemented and then deliberately removed. It could not be made both
    // correct and safe: keying off field presence meant a persisted value
    // constrained later writes that omitted the field, so a product left
    // reading "restock" rejected the next sale and took the till offline;
    // keying off diff().affectedKeys() meant consecutive sales -- the normal
    // case, same value each time -- skipped validation altogether. Both were
    // caught by tests/rules-deletion.test.mjs.
    //
    // The security value was negligible either way: someone writing stock down
    // to cover theft simply omits the field or labels it "sale". Prevention is
    // not reachable in rules, because rules authorise each write independently
    // and so cannot tie a stock decrement to a sale document created in the
    // same transaction. The real control is detective -- the sale record plus
    // the auditLogs entry, reconciled by the owner -- which is what this field
    // exists to make precise. See SECURITY-AUDIT.md F-4.
    function validMovementReason() {
      let after = request.resource.data;
      return !('movementReason' in after)
        || after.movementReason in ['sale', 'restock', 'return', 'void'];
    }

    function validStockMovementUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'sold30', 'sold90', 'updatedAt', 'movementReason'])
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && (!('sold30' in request.resource.data) || (request.resource.data.sold30 is number && request.resource.data.sold30 >= 0))
        && (!('sold90' in request.resource.data) || (request.resource.data.sold90 is number && request.resource.data.sold90 >= 0))
        && validMovementReason();
    }

    function validSaleItem(item) {
      return item.productId is string && item.productId.size() <= 128
        && item.name is string && item.name.size() > 0 && item.name.size() <= 120
        && item.qty is number && item.qty > 0 && item.qty <= 100000
        && item.lineTotal is number && item.lineTotal >= 0
        && (!('category' in item) || (item.category is string && item.category.size() <= 60))
        && (!('brand' in item) || (item.brand is string && item.brand.size() <= 60))
        && (!('supplier' in item) || (item.supplier is string && item.supplier.size() <= 60))
        && (!('sellingPrice' in item) || (item.sellingPrice is number && item.sellingPrice >= 0));
    }

    function itemValidAt(items, i) {
      return i >= items.size() || validSaleItem(items[i]);
    }

    function allItemsValid(items) {
      return itemValidAt(items, 0) && itemValidAt(items, 1) && itemValidAt(items, 2) && itemValidAt(items, 3) &&
        itemValidAt(items, 4) && itemValidAt(items, 5) && itemValidAt(items, 6) && itemValidAt(items, 7) &&
        itemValidAt(items, 8) && itemValidAt(items, 9) && itemValidAt(items, 10) && itemValidAt(items, 11) &&
        itemValidAt(items, 12) && itemValidAt(items, 13) && itemValidAt(items, 14) && itemValidAt(items, 15) &&
        itemValidAt(items, 16) && itemValidAt(items, 17) && itemValidAt(items, 18) && itemValidAt(items, 19) &&
        itemValidAt(items, 20) && itemValidAt(items, 21) && itemValidAt(items, 22) && itemValidAt(items, 23) &&
        itemValidAt(items, 24) && itemValidAt(items, 25) && itemValidAt(items, 26) && itemValidAt(items, 27) &&
        itemValidAt(items, 28) && itemValidAt(items, 29) && itemValidAt(items, 30) && itemValidAt(items, 31) &&
        itemValidAt(items, 32) && itemValidAt(items, 33) && itemValidAt(items, 34) && itemValidAt(items, 35) &&
        itemValidAt(items, 36) && itemValidAt(items, 37) && itemValidAt(items, 38) && itemValidAt(items, 39);
    }

    function validSale() {
      let d = request.resource.data;
      return d.items is list && d.items.size() > 0 && d.items.size() <= 40
        && d.total is number && d.total >= 0
        && d.cashierUid == request.auth.uid
        && d.voided == false
        && d.storeId is string && d.storeId.size() > 0
        && d.staffId is string && d.staffId.size() > 0
        && d.staffName is string && d.staffName.size() > 0 && d.staffName.size() <= 80
        && d.orderNumber is string && d.orderNumber.matches('^[0-9]{1,10}$')
        && (!('subtotal' in d) || (d.subtotal is number && d.subtotal >= 0))
        && (!('discountType' in d) || d.discountType in ['none', 'percent', 'fixed'])
        && (!('discountValue' in d) || (d.discountValue is number && d.discountValue >= 0))
        && (!('discountAmount' in d) || (d.discountAmount is number && d.discountAmount >= 0))
        && d.paymentMethod in ['cash', 'mobile', 'card', 'credit']
        && (!('customerId' in d) || d.customerId == null || (d.customerId is string && d.customerId.size() > 0))
        && (!('amountPaid' in d) || d.amountPaid == null || (d.amountPaid is number && d.amountPaid >= 0))
        && (!('balanceDue' in d) || d.balanceDue == null || (d.balanceDue is number && d.balanceDue >= 0))
        && allItemsValid(d.items);
    }

    function validAuditLog() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.action is string;
    }

    function validStore() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (!('archived' in d) || d.archived is bool)
        && (!('currencyCode' in d) || (d.currencyCode is string && d.currencyCode.matches('^[A-Z]{3}$')));
    }

    function validStaff() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('archived' in d) || d.archived is bool);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        // A client may never self-assign a deletion state on creation either.
        && !('status' in request.resource.data)
        && !('deletedAt' in request.resource.data)
        && !('deletionScheduledFor' in request.resource.data);
      // The deletion-lifecycle fields are Admin-SDK-only. If a client could
      // write `status` it could freeze its own tenant, or -- far worse --
      // clear `pending_deletion` to escape the grace period and un-schedule a
      // purge. Unchanged-comparison rather than absence, so a merge write that
      // legitimately carries the existing value still succeeds.
      // role stays immutable for the reason given in ensureUserProfile().
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        && request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null)
        && request.resource.data.get('deletionScheduledFor', null) == resource.data.get('deletionScheduledFor', null);
      allow delete: if false;

      match /products/{productId} {
        // resource == null: see the note on the same branch under /sales.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validProduct();
        allow update: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validProduct() && productImmutableFieldsUnchanged())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, resource.data.storeId) && validStockMovementUpdate()));
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      match /stores/{storeId} {
        // storeId here comes from the document path itself, not
        // resource.data -- Firestore can prove this rule per-document
        // using each doc's own ID, so no `where` clause is required for
        // this collection's list queries (unlike products/sales/etc.,
        // whose storeId lives in the document body -- see the query-side
        // filtering added around resolveQueryStoreIds() in app.js).
        allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, storeId));
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validStore();
        allow update: if isOwner(userId) && tenantNotFrozen(userId) && validStore();
        allow delete: if false;
      }

      match /staff/{staffId} {
        // Read opened to manager/cashier (Phase 3): staff need this list to
        // select their own name in POS. Write stays owner-only -- adding or
        // removing a cashier-name entry is still an owner action.
        allow read: if isOwner(userId) || isOwnerOrRole(userId, ["manager", "cashier"]);
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validStaff();
        allow update: if isOwner(userId) && tenantNotFrozen(userId) && validStaff();
        allow delete: if isOwner(userId) && tenantNotFrozen(userId);
      }

      // RBAC (Phase 2): members/{staffUid} docs are the source of truth for
      // role/store access (see memberDocPath() etc. above). Only the owner
      // may write these directly. A staff member may read their OWN doc
      // (needed so the client can show them their own role/store scope in
      // the UI), but never another member's doc, and never write to any
      // member doc themselves -- role/store escalation must only ever
      // happen through the proxy's accept-invite endpoint (Admin SDK),
      // never via a direct client write, even by the staff member it
      // concerns.
      match /members/{staffUid} {
        allow read: if isOwner(userId) || (signedIn() && request.auth.uid == staffUid);
        allow write: if isOwner(userId) && tenantNotFrozen(userId);
      }

      match /sales/{saleId} {
        function validVoidUpdate() {
          let before = resource.data;
          let after = request.resource.data;
          return before.voided == false
            && after.voided == true
            && after.voidedAt is timestamp
            && after.items == before.items
            && after.total == before.total
            && after.paymentMethod == before.paymentMethod
            && after.cashTendered == before.cashTendered
            && after.changeDue == before.changeDue
            && after.branchId == before.branchId
            && after.cashierUid == before.cashierUid
            && after.createdAt == before.createdAt
            && (!('storeId' in before) || after.storeId == before.storeId)
            && (!('staffId' in before) || after.staffId == before.staffId)
            && (!('orderNumber' in before) || after.orderNumber == before.orderNumber);
        }

        function validReturnUpdate() {
          let before = resource.data;
          let after = request.resource.data;
          return before.voided == false
            && after.items == before.items
            && after.total == before.total
            && after.paymentMethod == before.paymentMethod
            && after.cashTendered == before.cashTendered
            && after.changeDue == before.changeDue
            && after.voided == before.voided
            && (!('branchId' in before) || after.branchId == before.branchId)
            && (!('storeId' in before) || after.storeId == before.storeId)
            && after.cashierUid == before.cashierUid
            && after.createdAt == before.createdAt
            && (!('staffId' in before) || after.staffId == before.staffId)
            && (!('orderNumber' in before) || after.orderNumber == before.orderNumber)
            && after.returns is list && after.returns.size() <= 20
            && after.refundedAmount is number && after.refundedAmount >= 0 && after.refundedAmount <= after.total;
        }

        // A get() on a document that does not exist yields resource == null, and
        // reading a field off it makes the whole condition false rather than
        // erroring loudly. Completing a sale reads its own target id first, so a
        // retry resolves to the same path and cannot record the sale twice --
        // and on the normal path that read lands on a document that does not
        // exist yet. Without this branch every cashier and manager sale died at
        // the till with permission-denied; the owner never saw it because
        // isOwner short-circuits first. What a staff member can learn from the
        // null case is whether an id exists, never any content: an existing
        // document is still gated on their store access.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && isOwnerOrRole(userId, ["manager", "cashier"]) && validSale()
          && (isOwner(userId) || memberCanAccessStore(userId, request.resource.data.storeId));
        // Managers may void a full sale or process an itemized return, but
        // only for a store assigned to them -- owner reasoning revisited:
        // the owner isn't always on-site, and a manager already holds the
        // same trust level for returns. A void still has no itemized trail
        // (unlike a return, which is capped at the sale total and logged
        // per item), so this remains the single highest-trust write in the
        // schema; it's opened to managers only, never cashiers.
        allow update: if tenantNotFrozen(userId) && ((isOwner(userId) && (validVoidUpdate() || validReturnUpdate()))
          || (isOwnerOrRole(userId, ["manager"])
            && memberCanAccessStore(userId, resource.data.storeId)
            && (validVoidUpdate() || validReturnUpdate())));
        allow delete: if false;
      }

     match /customers/{customerId} {
        function validCustomer() {
          let d = request.resource.data;
          return d.name is string && d.name.size() <= 80
            && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
            && d.balanceOwed is number && d.balanceOwed >= 0
            && d.storeId is string && d.storeId.size() > 0
            && (!('oldestUnpaidAt' in d) || d.oldestUnpaidAt == null || d.oldestUnpaidAt is timestamp)
            && (!('creditLimit' in d) || d.creditLimit == null || (d.creditLimit is number && d.creditLimit >= 0));
        }
        // Cashier-safe: a credit sale (or recording a payment) only ever
        // touches balanceOwed/oldestUnpaidAt -- diff-checked so a cashier
        // write can't sneak in a creditLimit or name change alongside it.
        function validCustomerBalanceUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceOwed', 'oldestUnpaidAt', 'updatedAt'])
            && request.resource.data.balanceOwed is number && request.resource.data.balanceOwed >= 0;
        }
        // Credit limit is a manager/owner judgment call, not a cashier one.
        function validCustomerLimitUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditLimit']);
        }
        // resource == null: see the note on the same branch under /sales.
        allow read: if isOwner(userId)
          || (isOwnerOrRole(userId, ["manager", "cashier"])
              && (resource == null || memberCanAccessStore(userId, resource.data.storeId)));
        allow create: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validCustomer())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, request.resource.data.storeId) && validCustomer()));
        allow update: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validCustomer())
          || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, resource.data.storeId) && validCustomerBalanceUpdate())
          || (isOwnerOrRole(userId, ["manager"]) && memberCanAccessStore(userId, resource.data.storeId) && validCustomerLimitUpdate()));
        allow delete: if false;

        match /payments/{paymentId} {
          function validPayment() {
            let d = request.resource.data;
            return d.amount is number && d.amount > 0
              && (!('note' in d) || (d.note is string && d.note.size() <= 200));
          }
          allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, get(/databases/$(database)/documents/users/$(userId)/customers/$(customerId)).data.storeId));
          allow create: if tenantNotFrozen(userId) && (
               (isOwner(userId) && validPayment())
            || (isOwnerOrRole(userId, ["manager", "cashier"]) && memberCanAccessStore(userId, get(/databases/$(database)/documents/users/$(userId)/customers/$(customerId)).data.storeId) && validPayment()));
          allow update, delete: if false;
        }
      }

      match /transfers/{transferId} {
        function validTransfer() {
          let d = request.resource.data;
          return d.productId is string && d.productId.size() > 0
            && d.productName is string && d.productName.size() <= 120
            && d.quantity is number && d.quantity > 0 && d.quantity <= 1000000
            && d.sourceStoreId is string && d.sourceStoreId.size() > 0
            && d.destinationStoreId is string && d.destinationStoreId.size() > 0
            && d.staffName is string && d.staffName.size() > 0 && d.staffName.size() <= 80
            && (!('destinationProductId' in d) || (d.destinationProductId is string && d.destinationProductId.size() > 0))
            && (!('sourceStoreName' in d) || (d.sourceStoreName is string && d.sourceStoreName.size() <= 60))
            && (!('destinationStoreName' in d) || (d.destinationStoreName is string && d.destinationStoreName.size() <= 60))
            && d.performedByUid == request.auth.uid;
        }
        allow read: if isOwner(userId) || (isOwnerOrRole(userId, ["manager", "cashier"]) && (memberCanAccessStore(userId, resource.data.sourceStoreId) || memberCanAccessStore(userId, resource.data.destinationStoreId)));
        allow create: if tenantNotFrozen(userId) && (
             (isOwner(userId) && validTransfer())
          || (isOwnerOrRole(userId, ["manager"]) && validTransfer()
              && memberCanAccessStore(userId, request.resource.data.sourceStoreId)
              && memberCanAccessStore(userId, request.resource.data.destinationStoreId)));
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        // Deliberately NOT gated on tenantNotFrozen(). A frozen tenant must
        // still be able to record what happened to it -- the deletion request
        // itself, the restore, and any access attempt during the grace period
        // are exactly the events an erasure audit needs. Freezing the audit
        // log would destroy the evidence trail for the deletion it is meant
        // to document. Entries remain append-only regardless.
        allow read: if isOwner(userId);
        allow create: if isOwnerOrRole(userId, ["manager", "cashier"]) && validAuditLog();
        allow update, delete: if false;
      }

      match /monthlyReports/{reportId} {
        function validMonthlyReport() {
          let d = request.resource.data;
          return d.storeId is string && d.storeId.size() > 0
            && d.periodLabel is string && d.periodLabel.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && d.periodStart is timestamp && d.periodEnd is timestamp
            && d.generatedBy == request.auth.uid
            && d.metrics is map
            && d.aiSummary is string && d.aiSummary.size() <= 6000;
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && tenantNotFrozen(userId) && validMonthlyReport();
        allow update: if isOwner(userId) && tenantNotFrozen(userId) && validMonthlyReport();
        allow delete: if false;
      }

      // Per-business override-password hash (Phase 9). No client may read or
      // write this directly, not even the doc's own owner -- if it were
      // readable, the owner's own browser could fetch the hash and brute-
      // force it offline, defeating server-side verification entirely. Only
      // the proxy's Firebase Admin SDK (which bypasses these rules) may
      // touch it, via POST /api/settings/override-password and
      // POST /api/ai/override-verify in proxy/server.js.
      match /private/security {
        allow read, write: if false;
      }
    }
  }
}
