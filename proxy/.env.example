ANTHROPIC_API_KEY=replace_with_your_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=8787
CORS_ORIGINS=http://localhost:5173,https://sanitaryflow-erp.web.app,https://sanitaryflow-erp.firebaseapp.com
REQUIRE_FIREBASE_AUTH=false
FIREBASE_PROJECT_ID=sanitaryflow-erp
# bcrypt hash of the LEGACY shared price-override password (never the plaintext).
# Generate with: node -e "require('bcryptjs').hash(process.argv[1],10).then(console.log)" "your-password-here"
# Phase 9: this is now only a fallback for businesses that haven't set their
# own per-account override password yet (see FIREBASE_SERVICE_ACCOUNT_KEY_BASE64
# below). Once every business you care about has migrated, remove this var
# entirely — leaving it in forever re-creates a password shared by every
# tenant on the platform.
PRICE_OVERRIDE_PASSWORD_HASH=replace_with_a_bcrypt_hash

# Base64-encoded Firebase service-account JSON key. Get the raw key from the
# Firebase console: Project Settings -> Service Accounts -> Generate new
# private key. Then base64-encode the whole downloaded file, e.g.:
#   node -e "console.log(Buffer.from(require('fs').readFileSync(process.argv[1])).toString('base64'))" "path\to\serviceAccountKey.json"
# Base64 avoids Render's env var UI mangling the key's embedded newlines.
# Powers per-business override passwords (Phase 9): without this set,
# POST /api/settings/override-password returns 503 and every business falls
# back to the single legacy PRICE_OVERRIDE_PASSWORD_HASH above.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=replace_with_base64_encoded_service_account_json

# Deletion job scheduler secret (see DATA-DELETION.md). Generate with:
#   openssl rand -hex 32
# Must match the DELETION_JOB_SECRET GitHub Actions secret.
DELETION_JOB_SECRET=replace_with_a_long_random_hex_string
